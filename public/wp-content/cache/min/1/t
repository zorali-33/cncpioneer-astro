  font-size: 15px;
  color: #374151;
  line-height: 1.8;
  margin-bottom: 28px;
}
.overview-body p + p { margin-top: 14px; }

/* Key points — 2-col icon list */
.op-list {
  list-style: none;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 24px;
  margin-bottom: 28px;
}
.op-list li {
