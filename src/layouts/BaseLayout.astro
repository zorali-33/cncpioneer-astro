---
import SeoHead from "../components/native/SeoHead.astro";
import SiteHeader from "../components/native/SiteHeader.astro";
import SiteFooter from "../components/native/SiteFooter.astro";
import SiteHeaderSpacer from "../components/native/SiteHeaderSpacer.astro";

const { seo } = Astro.props;
---
<!doctype html>
<html lang="en-US">
  <head>
    <SeoHead {...seo} />
    <slot name="head" />
    <style is:global>
      :root {
        --navy: var(--color-ink);
        --text: var(--color-body);
        --blue: var(--color-brand);
        --cta-blue: var(--color-brand);
        --bright-blue: var(--color-brand);
        --muted: var(--color-surface);
        --border: var(--color-border);
        --yellow: var(--color-brand);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        max-width: 100%;
        overflow-x: hidden;
      }

      body {
        font-family: var(--font-sans);
        color: var(--text);
        background: var(--color-white);
        line-height: 1.5;
      }

      a {
        color: inherit;
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      .page-hero {
        position: relative;
        min-height: 352px;
        display: flex;
        align-items: center;
        background: var(--hero-image) center / cover no-repeat;
        color: var(--color-white);
      }

      .page-hero__overlay {
        position: absolute;
        inset: 0;
        background: rgb(var(--color-body-rgb)/0.5);
      }

      .page-hero__content {
        position: relative;
        z-index: 1;
        width: min(63%, 720px);
        margin-left: max(24px, calc((100vw - var(--layout-shell)) / 2));
        padding: 50px 0;
      }

      .breadcrumbs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 26px;
        font-family: var(--font-sans);
        font-size: 14px;
      }

      .breadcrumbs a {
        color: var(--color-white);
        text-decoration: none;
      }

      .hero-eyebrow {
        margin: 0 0 10px;
        color: var(--color-white);
        font-size: 13px;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .page-hero h1 {
        margin: 0 0 20px;
        color: var(--color-white);
        font-size: var(--type-h1);
        line-height: 1.12;
        font-weight: 700;
      }

      .page-hero p {
        margin: 0 0 28px;
        color: var(--color-white);
        font-size: 16px;
        font-weight: 500;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 10px 24px;
        border-radius: 4px;
        background: var(--bright-blue);
        color: var(--color-white);
        font-weight: 700;
        text-decoration: underline;
      }

      .section {
        max-width: var(--layout-shell);
        margin: 0 auto;
        padding: 58px 24px;
      }

      .section h2 {
        margin: 0 0 18px;
        color: var(--color-ink);
        text-align: center;
        font-size: var(--type-h2);
        line-height: 1.2;
        font-weight: 700;
      }

      .section__intro {
        max-width: 980px;
        margin: 0 auto 44px;
        color: var(--text);
        text-align: center;
        font-size: 20px;
        font-weight: 400;
      }

      .media-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 24px;
      }

      .service-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 28px;
      }

      .service-card,
      .link-card {
        display: flex;
        flex-direction: column;
        min-height: 100%;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--color-white);
        box-shadow: 0 14px 34px rgb(var(--color-ink-rgb)/0.08);
      }

      .service-card h2,
      .link-card h3 {
        margin: 0 0 14px;
        color: var(--navy);
        text-align: left;
        font-size: var(--type-h2);
      }

      .service-card p,
      .link-card p {
        margin: 0 0 24px;
        font-weight: 400;
      }

      .service-card__actions {
        margin-top: auto;
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }

      .text-link {
        color: var(--blue);
        font-weight: 700;
        text-decoration: underline;
      }

      .chip-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 18px;
      }

      .chip {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 66px;
        padding: 14px 18px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--color-white);
        color: var(--navy);
        text-align: center;
        font-weight: 600;
      }

      .capability-table {
        width: 100%;
        border-collapse: collapse;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--color-white);
      }

      .capability-table th,
      .capability-table td {
        padding: 16px 18px;
        border-bottom: 1px solid var(--border);
        text-align: left;
      }

      .capability-table th {
        background: var(--muted);
        color: var(--navy);
      }

      .capability-table tr:last-child td {
        border-bottom: 0;
      }

      .media-card {
        overflow: hidden;
        background: var(--color-white);
      }

      .media-card img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
      }

      .media-card figcaption {
        padding: 12px;
        color: var(--navy);
        text-align: center;
        font-weight: 500;
      }

      .product-media-grid {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }

      .product-media-card {
        border: 1px solid var(--border);
        border-radius: 6px;
        box-shadow: 0 12px 28px rgb(var(--color-ink-rgb)/0.06);
      }

      .product-media-card img {
        padding: 16px;
        background: var(--color-white);
        object-fit: contain;
      }

      .material-intro > img {
        width: 100%;
        height: 490px;
        object-fit: cover;
        object-position: center;
      }

      .material-intro {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 56px;
        align-items: center;
        padding-top: 50px;
        padding-bottom: 50px;
      }

      .material-intro h2 {
        margin-bottom: 22px;
        color: var(--navy);
        text-align: left;
        font-family: var(--font-sans);
        font-size: var(--type-h2);
        font-weight: 700;
        line-height: 1.2;
        text-transform: capitalize;
      }

      .material-intro p {
        margin: 0;
        color: var(--text);
        font-size: 16px;
        font-weight: 400;
        line-height: 1.5;
      }

      .material-intro__media img {
        width: 100%;
        height: 490px;
        object-fit: cover;
        object-position: center;
      }

      .material-parts {
        padding-top: 50px;
        padding-bottom: 50px;
      }

      .material-parts .section__intro {
        max-width: 980px;
        margin-bottom: 36px;
        font-size: 22px;
        line-height: 1.5;
      }

      .material-parts__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(190px, 300px));
        justify-content: center;
        gap: 52px 80px;
      }

      .material-parts__carousel {
        position: relative;
        max-width: 1090px;
        margin: 0 auto;
      }

      .material-parts__carousel.is-scrollable {
        padding-inline: 54px;
      }

      .material-parts__viewport {
        overflow-x: auto;
        scrollbar-width: none;
        scroll-snap-type: x mandatory;
      }

      .material-parts__viewport::-webkit-scrollbar {
        display: none;
      }

      .material-parts__viewport:focus-visible {
        outline: 2px solid var(--bright-blue);
        outline-offset: 4px;
      }

      .material-parts__track {
        --parts-gap: 80px;
        display: flex;
        gap: var(--parts-gap);
        align-items: flex-start;
      }

      .material-part {
        margin: 0;
        text-align: center;
      }

      .material-parts__track .material-part {
        flex: 0 0 var(--parts-basis, calc((100% - (var(--parts-gap) * 2)) / 3));
        min-width: 0;
        scroll-snap-align: start;
      }

      .material-parts__arrow {
        position: absolute;
        top: calc(50% - 16px);
        z-index: 1;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border: 1px solid var(--border);
        border-radius: 50%;
        background: var(--color-white);
        color: var(--navy);
        box-shadow: 0 4px 14px rgb(var(--color-ink-rgb)/0.08);
        cursor: pointer;
        transform: translateY(-50%);
      }

      .material-parts__arrow[hidden] {
        display: none;
      }

      .material-parts__arrow--prev { left: 0; }
      .material-parts__arrow--next { right: 0; }

      .material-parts__arrow svg {
        width: 24px;
        height: 24px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .material-parts__arrow:hover:not(:disabled) {
        border-color: var(--bright-blue);
        color: var(--bright-blue);
        background: var(--color-surface);
      }

      .material-parts__arrow:focus-visible {
        border: 2px solid var(--bright-blue);
        color: var(--bright-blue);
        background: var(--color-surface);
        outline: none;
      }

      .material-parts__arrow:disabled {
        opacity: 0.35;
        cursor: default;
        box-shadow: none;
      }

      .material-part img {
        width: 300px;
        height: 300px;
        margin: 0 auto;
        object-fit: contain;
        background: var(--color-surface);
      }

      .material-part figcaption {
        margin-top: 12px;
        padding: 0;
        color: var(--navy);
        font-size: 14px;
        font-style: italic;
        font-weight: 400;
      }

      .metal-types {
        padding-top: 58px;
        padding-bottom: 64px;
        background: var(--color-surface);
      }

      .metal-tabs__list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        max-width: 1110px;
        margin: 28px auto 36px;
      }

      .metal-tab {
        min-height: 48px;
        padding: 0 21px;
        border: 1px solid var(--color-border);
        background: var(--color-white);
        color: var(--color-body);
        font: inherit;
        font-size: 16px;
        line-height: 1.2;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }

      .metal-tab.is-active,
      .metal-tab:hover {
        border-color: var(--blue);
        background: var(--blue);
        color: var(--color-white);
      }

      .metal-tabs__panels {
        max-width: 1110px;
        margin: 0 auto;
      }

      .metal-panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(360px, 520px);
        gap: 42px;
        align-items: center;
        padding: 38px;
        background: var(--color-white);
        box-shadow: 0 10px 28px rgb(var(--color-ink-rgb)/0.08);
      }

      .metal-panel[hidden] {
        display: none;
      }

      .metal-panel h3 {
        margin-bottom: 18px;
        color: var(--navy);
        font-size: 26px;
        line-height: 1.25;
      }

      .metal-panel p {
        margin: 0 0 22px;
        color: var(--color-body);
        font-size: 17px;
        line-height: 1.58;
      }

      .metal-panel .check-list {
        margin-bottom: 24px;
      }

      .metal-panel .button--small {
        min-height: 38px;
        padding: 10px 22px;
        font-size: 14px;
      }

      .metal-panel__media img {
        width: 100%;
        height: 360px;
        object-fit: cover;
      }

      .metal-slider-section {
        padding-top: 52px;
        padding-bottom: 62px;
      }

      .metal-slider-section .section__intro {
        max-width: 980px;
        margin-bottom: 34px;
        font-size: 20px;
        line-height: 1.55;
      }

      .metal-slider {
        position: relative;
        max-width: 1110px;
        margin: 0 auto;
        padding: 0 42px 36px;
      }

      .metal-slider__viewport {
        overflow: hidden;
      }

      .metal-slider__track {
        display: flex;
        gap: 34px;
        align-items: stretch;
        transition: transform 0.5s ease;
      }

      .metal-slide {
        flex: 0 0 calc((100% - 68px) / 3);
        margin: 0;
        text-align: center;
      }

      .metal-slide img {
        width: 100%;
        height: 250px;
        object-fit: cover;
        background: var(--color-surface);
      }

      .metal-slider--industries .metal-slide img {
        height: 220px;
      }

      .metal-slide figcaption {
        margin-top: 12px;
        color: var(--navy);
        font-size: 15px;
        font-style: italic;
        line-height: 1.4;
      }

      .metal-slider__button {
        position: absolute;
        top: 116px;
        z-index: 2;
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border: 0;
        border-radius: 50%;
        background: rgb(var(--color-ink-rgb)/0.82);
        color: var(--color-white);
        font-size: 30px;
        line-height: 1;
        cursor: pointer;
      }

      .metal-slider__button:disabled {
        opacity: 0.45;
        cursor: default;
      }

      .metal-slider__button--prev {
        left: 0;
      }

      .metal-slider__button--next {
        right: 0;
      }

      .metal-slider__dots {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 22px;
      }

      .metal-slider__dot {
        width: 8px;
        height: 8px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: var(--color-surface);
        cursor: pointer;
      }

      .metal-slider__dot.is-active {
        background: var(--blue);
      }

      .metal-industries-section {
        padding-top: 46px;
        padding-bottom: 62px;
      }

      .material-capabilities {
        padding-top: 72px;
        padding-bottom: 58px;
      }

      .material-service-grid {
        max-width: 980px;
        margin: 28px auto 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 30px;
      }

      .material-service-card {
        height: 260px;
        display: flex;
        overflow: hidden;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        background: var(--color-white);
        box-shadow: 0 2px 4px rgb(var(--color-ink-rgb)/0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }

      .material-service-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgb(var(--color-ink-rgb)/0.1);
      }

      .material-service-card__image {
        flex: 0 0 33.333%;
        max-width: 33.333%;
        min-height: 100%;
        overflow: hidden;
      }

      .material-service-card__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .material-service-card__content {
        flex: 0 0 66.667%;
        max-width: 66.667%;
        padding: 15px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .material-service-card h3 {
        margin: 0 0 10px;
        color: var(--color-ink);
        font-size: 18px;
        font-weight: 600;
        line-height: 1.35;
      }

      .material-service-card p {
        margin: 0 0 10px;
        color: var(--color-body);
        font-size: 14px;
        line-height: 1.5;
      }

      .material-service-card__links {
        margin-top: auto;
      }

      .material-service-card__links a {
        display: block;
        margin-top: 8px;
        color: var(--bright-blue);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
      }

      .material-service-card__links a:hover {
        color: var(--color-hover);
        text-decoration: underline;
      }

      .service-link-card {
        gap: 16px;
      }

      .service-link-card img {
        width: 100%;
        aspect-ratio: 27 / 13;
        object-fit: cover;
        border-radius: 4px;
      }

      .split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 56px;
        align-items: center;
      }

      .split h2 {
        text-align: left;
        color: var(--navy);
      }

      .split p {
        font-weight: 400;
      }

      .check-list {
        list-style: none;
        padding: 0;
        margin: 34px 0 0;
      }

      .check-list li {
        position: relative;
        margin: 0 0 15px;
        padding-left: 30px;
        color: var(--text);
        font-size: 16px;
        font-weight: 400;
        line-height: 1.5;
      }

      .check-list li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.35em;
        width: 14px;
        height: 14px;
        border: 1.5px solid var(--blue);
        border-radius: 50%;
        color: var(--blue);
      }

      .check-list li::after {
        content: "";
        position: absolute;
        left: 4px;
        top: calc(0.35em + 3px);
        width: 5px;
        height: 3px;
        border-left: 1.5px solid var(--blue);
        border-bottom: 1.5px solid var(--blue);
        transform: rotate(-45deg);
      }

      .feature-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8%;
        margin-top: 50px;
      }

      .feature-card {
        text-align: center;
      }

      .feature-card h3 {
        margin: 0 0 10px;
        color: var(--navy);
        font-size: 22px;
        line-height: 1.2;
      }

      .feature-card p {
        margin: 0;
        font-weight: 400;
      }

      .cta-band {
        min-height: 343px;
        display: grid;
        place-items: center;
        padding: 64px 24px;
        background: var(--cta-blue);
        color: var(--color-white);
        text-align: center;
      }

      .cta-band p {
        margin: 0 0 18px;
        color: var(--yellow);
        font-family: var(--font-sans);
        font-size: 22px;
        font-weight: 400;
      }

      .cta-band h2 {
        margin: 0 0 24px;
        color: var(--color-white);
        font-family: var(--font-sans);
        font-size: var(--type-h2);
        line-height: 1.2;
        text-transform: uppercase;
      }

      .faq-section h2 {
        text-align: center;
      }

      .faq-list {
        max-width: 980px;
        margin: 0 auto;
        display: grid;
        gap: 14px;
      }

      .faq-list details {
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--color-white);
      }

      .faq-list summary {
        cursor: pointer;
        padding: 18px 22px;
        color: var(--navy);
        font-weight: 700;
      }

      .faq-list p {
        margin: 0;
        padding: 0 22px 20px;
        font-weight: 400;
      }

      .faq-section--material {
        max-width: none;
        padding: 5% 10%;
        background: var(--color-surface);
      }

      .faq-section--material h2 {
        margin-bottom: 54px;
      }

      .faq-section--material .faq-list {
        max-width: 820px;
        display: block;
        border-top: 3px solid var(--color-border);
      }

      .faq-section--material .faq-list details {
        border: 0;
        border-bottom: 1px solid var(--color-border);
        border-radius: 0;
        background: transparent;
      }

      .faq-section--material .faq-list details:not(:last-child) {
        margin-bottom: 16px;
      }

      .faq-section--material .faq-list summary {
        position: relative;
        display: block;
        padding: 35px 42px 35px 0;
        color: var(--color-body);
        font-family: var(--font-sans);
        font-size: 24px;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.45px;
        list-style: none;
      }

      .faq-section--material .faq-list summary::-webkit-details-marker {
        display: none;
      }

      .faq-section--material .faq-list summary::after {
        content: "+";
        position: absolute;
        right: 0;
        top: 50%;
        color: var(--color-body);
        font-family: var(--font-sans);
        font-size: 34px;
        font-weight: 700;
        line-height: 1;
        transform: translateY(-50%);
      }

      .faq-section--material .faq-list details[open] summary::after {
        content: "-";
      }

      .faq-section--material .faq-list p {
        padding: 0 0 28px;
        color: var(--color-ink);
        font-family: var(--font-sans);
        font-size: 18px;
        font-weight: 400;
        line-height: 1.2;
      }

      .material-learning {
        padding-top: 72px;
        padding-bottom: 78px;
      }

      .material-learning h2 {
        margin-bottom: 36px;
        color: var(--color-ink);
      }

      .learning-grid {
        max-width: 1040px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 30px;
      }

      .learning-card {
        overflow: hidden;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-white);
        box-shadow: 0 4px 12px rgb(var(--color-ink-rgb)/0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }

      .learning-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgb(var(--color-ink-rgb)/0.1);
      }

      .learning-card__image {
        position: relative;
        display: block;
        overflow: hidden;
        padding-top: 66.67%;
        background: var(--color-surface);
      }

      .learning-card__image img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
      }

      .learning-card__image:hover img {
        transform: scale(1.05);
      }

      .learning-card__body {
        padding: 25px;
      }

      .learning-card h3 {
        margin: 0 0 15px;
        font-size: 20px;
        font-weight: 600;
        line-height: 1.4;
      }

      .learning-card h3 a {
