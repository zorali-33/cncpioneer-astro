---
import '../../styles/blog-native.css';
import '../../styles/blog-detail-native.css';
import BlogDetailTemplate from '../../components/native/BlogDetailTemplate.astro';
import {
  getNativeBlogEntries,
  getBlogDetailEntries,
  relatedPostsFor,
} from '../../blog-detail-native.mjs';

const pages = import.meta.glob("../../mirrored-pages/blog/*/index.html", {
  query: "?raw",
  import: "default",
  eager: true,
});

export function getStaticPaths() {
  const staticPages = import.meta.glob("../../mirrored-pages/blog/*/index.html", {
    query: "?raw",
    import: "default",
    eager: true,
  });
  const entries = getNativeBlogEntries(staticPages);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const entries = getBlogDetailEntries(pages);
const relatedPosts = relatedPostsFor(entry.slug, entries);
---

<BlogDetailTemplate article={entry.detail} relatedPosts={relatedPosts} />
