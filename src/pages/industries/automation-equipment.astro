---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompactQuoteForm from '../../components/native/CompactQuoteForm.astro';
import { jsonLd } from '../../data/articleSchema.mjs';
import { automationSeo, automationParts, automationBenefits, automationCapabilities, automationSteps, automationFaqs } from '../../data/automationContent.mjs';
import '../../styles/automation-equipment.css';
const faqSchema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:automationFaqs.map(faq=>({'@type':'Question',name:faq.question,acceptedAnswer:{'@type':'Answer',text:faq.answer}}))};
---
<BaseLayout seo={automationSeo}>
  <script slot="head" type="application/ld+json" set:html={jsonLd(faqSchema)} />
  <div class="automation-page">
    <section class="ae-hero" aria-labelledby="automation-title"><div class="ae-shell">
      <nav class="ae-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/industries">Industries</a><span aria-hidden="true">/</span><span aria-current="page">Automation Equipment Parts</span></nav>
      <div class="ae-hero-grid"><div><p class="ae-kicker">AUTOMATION EQUIPMENT</p><h1 id="automation-title">Automation Equipment cnc machining services</h1><p class="ae-lead">Plates, brackets, shafts and fixtures for special-purpose machine builders. Bring your BOM together for a drawing-based machining review.</p><div class="ae-actions"><a class="ae-button" href="#rfq">Send Your BOM <span aria-hidden="true">→</span></a><a class="ae-button ae-outline" href="#parts">View Parts</a></div></div>
        <figure><img class="hero-img" src="/assets/images/automation-parts-hero.webp" width="1200" height="900" alt="Representative plates, brackets, shafts and fixture components for custom automation equipment" loading="eager" fetchpriority="high" decoding="async" /></figure>
      </div>
    </div></section>
    <section class="ae-proof" aria-label="Reference machining capability"><div class="ae-shell"><dl><div><dt>Sample production*</dt><dd><span class="ae-metric">3–5</span> <span>working days</span></dd></div><div><dt>Batch production*</dt><dd><span class="ae-metric">7–15</span> <span>working days</span></dd></div><div><dt>CNC machines in register</dt><dd><span class="ae-metric">86</span></dd></div><div><dt>Critical features, on review</dt><dd><span class="ae-metric">±0.01</span> <span>mm</span></dd></div></dl><p class="caption">*Reference windows, confirmed with your quotation. Transit time is separate. Tolerances depend on material, geometry and process.</p></div></section>
    <section id="parts" class="ae-section ae-shell" aria-labelledby="parts-title"><div class="ae-section-heading"><div><h2 id="parts-title">Parts we machine for automation equipment</h2><p>The custom components in your machine, made to your drawings.</p></div><a class="ae-text-link" href="/custom-cnc-parts">All custom parts <span aria-hidden="true">→</span></a></div>
      <div class="ae-parts-grid">{automationParts.map(part=><article><a href={part.href}><img src={`/assets/images/${part.image}.webp`} alt={part.alt} width="800" height="600" loading="lazy" decoding="async"/><h3>{part.title}</h3></a><p>{part.text}</p></article>)}</div>
      <p class="ae-image-note caption">AI-generated application images illustrate part types and workflows; they are not photographs of delivered projects.</p>
    </section>
    <section class="ae-surface"><div class="ae-section ae-shell"><div class="ae-heading"><h2>Built for how machine builders buy</h2><p>Many different parts, a few of each, all needed for the same build.</p></div><div class="ae-benefits">{automationBenefits.map(item=><article><img src={`/assets/images/${item.image}.webp`} width="900" height="600" alt={item.alt} loading="lazy" decoding="async"/><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
    <section class="ae-section ae-shell ae-capabilities" aria-labelledby="capabilities-title"><figure><img src="/assets/images/cnc-machining-centers-equipment-photo.webp" width="733" height="549" alt="CNC machining centers documented in the factory equipment portfolio" loading="lazy" decoding="async"/><figcaption>Factory equipment photograph · CNC machining centers</figcaption></figure><div><h2 id="capabilities-title">Capabilities at a glance</h2><p>Match the machining route to the interfaces, materials and finishes your assembly needs.</p><dl>{automationCapabilities.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><a class="ae-text-link" href="/resources/equipment-list">View equipment documentation <span aria-hidden="true">→</span></a></div></section>
    <section class="ae-surface"><div class="ae-section ae-shell"><div class="ae-heading"><h2>From BOM to parts in four steps</h2></div><ol class="ae-process">{automationSteps.map(([title,text],i)=><li><span class="ae-step">0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
    <section id="rfq" class="ae-section ae-shell ae-rfq" aria-labelledby="rfq-title"><div><p class="ae-kicker">START WITH YOUR DRAWINGS</p><h2 id="rfq-title">Get your BOM reviewed</h2><p>Include these details so we can review each line with fewer follow-up questions.</p><ul><li>BOM with part numbers, revisions and quantities</li><li>STEP models and dimensioned PDF drawings</li><li>Material grade, finish and critical fits for each line</li><li>Inspection reports, packaging and target delivery date</li></ul><p class="body-small">For a multi-file enquiry, combine your BOM and drawings in a ZIP file. Maximum upload: 50 MB.</p><p class="ae-email">Prefer email? <a href="mailto:info@cncpioneer.com">info@cncpioneer.com</a></p></div><CompactQuoteForm idPrefix="automation-bom" formName="Automation Equipment BOM Review" submitLabel="Send BOM for Review" /></section>
    <section id="faq" class="ae-surface"><div class="ae-section ae-shell ae-faq"><div><h2>Automation Equipment FAQ</h2><p>New to machine building? Read <a class="ae-text-link" href="/blog/what-is-automation-equipment">what automation equipment is</a> for types, components and practical examples.</p></div><div>{automationFaqs.map(faq=><details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></div></section>
  </div>
</BaseLayout>
