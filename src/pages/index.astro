---
import BaseLayout from "../layouts/BaseLayout.astro";
import CompactQuoteForm from "../components/native/CompactQuoteForm.astro";
import { finishes } from "../data/threeAxisContent.mjs";

const seo = {
  "title": "Custom CNC Machining Services | Milling & Turning | CNCPioneer",
  "description": "Custom CNC machining for metal and plastic parts, from prototypes to production. Explore milling, turning, Swiss machining and finishing. Request a quote.",
  "canonical": "/",
  "type": "website",
  "image": "/wp-content/uploads/2025/12/cncpioneer-1.jpg"
};

const services = [
  {
    title: "3-Axis CNC Machining",
    image: "/assets/images/cnc-aluminum-pocket-milling-process.webp",
    href: "/services/3-axis-cnc-machining",
    label: "Explore 3-Axis Machining",
    text: "For prismatic parts with flat faces, pockets, slots and drilled features.",
  },
  {
    title: "5-Axis CNC Machining",
    image: "/assets/images/five-axis-multi-face-structural-component.webp",
    alt: "Multi-face structural component from our factory part portfolio",
    width: 1280,
    height: 855,
    href: "/services/5-axis-cnc-machining",
    label: "Explore 5-Axis Machining",
    text: "For complex contours and angled features across multiple faces, often with fewer setups.",
  },
  {
    title: "Swiss Machining",
    image: "/wp-content/uploads/2025/12/swiss-machining-service-540x260-1.png",
    href: "/services/swiss-machining",
    label: "Explore Swiss Machining",
    text:
      "For small-diameter, slender parts such as precision shafts, connector pins and threaded fittings.",
  },
  {
    title: "CNC Turning & Milling",
    image: "/wp-content/uploads/2025/12/cnc-turning-and-milling-services-540x260-1.png",
    href: "/services/cnc-turning-and-milling",
    label: "Explore Turning & Milling",
    text:
      "For parts combining turned profiles with milled flats, holes or other features.",
  },
];

const heroBullets = [
  "5–7 Day Lead Time",
  "One-stop machining & surface finishing",
  "General Tolerance ±0.01 mm",
  "Drawing review & dimensional inspection"
];


const materialTabs = [
  {
    label: "Metals",
    items: [
      ["Stainless Steel", "/materials/stainless-steel-cnc-machining", "/wp-content/uploads/2026/02/stainless-steel-55x55-1.jpg"],
      ["Aluminum", "/materials/aluminum-cnc-machining", "/wp-content/uploads/2026/02/aluminum-55x55-1.jpg"],
      ["Brass", "/materials/brass-cnc-machining", "/wp-content/uploads/2026/02/brass-55x55-1.jpg"],
      ["Bronze", "/materials/bronze-cnc-machining", "/wp-content/uploads/2026/02/bronze-55x55-1.jpg"],
      ["Copper", "/materials/copper-cnc-machining", "/wp-content/uploads/2026/02/copper-55x55-1.jpg"],
      ["Magnesium", "/materials/magnesium-cnc-machining", "/wp-content/uploads/2026/02/magnesium-55x55-1.jpg"],
      ["Titanium", "/materials/titanium-cnc-machining", "/wp-content/uploads/2026/02/titanium-55x55-2.jpg"],
      ["Nitinol", "/materials/nitinol-cnc-machining", "/wp-content/uploads/2026/02/nitinol.jpg"],
      ["Alloy Steel", "/materials/alloy-steel-cnc-machining", "/wp-content/uploads/2026/02/alloy-steel-55x55-1.jpg"],
      ["Carbon Steel", "/materials/carbon-steel-cnc-machining", "/wp-content/uploads/2026/02/carbon-steel-55x55-1.jpg"],
      ["Kovar", "/materials/kovar-cnc-machining", "/wp-content/uploads/2026/02/kovar-55x55-1.jpg"],
      ["Inconel", "/materials/inconel-cnc-machining", "/wp-content/uploads/2026/02/inconel-55x55-1.jpg"],
      ["Invar", "/materials/invar-cnc-machining", "/wp-content/uploads/2026/02/invar-55x55-1.jpg"],
    ],
  },
  {
    label: "Engineering Plastics",
    items: [
      ["PEEK", "/materials/peek-cnc-machining", "/wp-content/uploads/2026/02/peek-55x55-1.jpg"],
      ["Nylon", "/materials/nylon-cnc-machining", "/wp-content/uploads/2026/02/nylon-55x55-1.jpg"],
      ["ABS", "/materials/abs-cnc-machining", "/wp-content/uploads/2026/02/abs-55x55-1.jpg"],
      ["Acrylic", "/materials/acrylic-cnc-machining", "/wp-content/uploads/2026/02/acrylic-55x55-1.jpg"],
      ["Acetal (POM)", "/materials/pom-cnc-machining", "/wp-content/uploads/2026/02/acetal-55x55-1.jpg"],
      ["HDPE", "/materials/hdpe-cnc-machining", "/wp-content/uploads/2026/02/HDPE-55x55-1.jpg"],
      ["Polycarbonate", "/materials/polycarbonate-cnc-machining", "/wp-content/uploads/2026/02/polycarbonate-55x55-1.jpg"],
      ["Polypropylene", "/materials/polypropylene-cnc-machining", "/wp-content/uploads/2026/02/polypropylene-55x55-1.jpg"],
      ["PTFE", "/materials/ptfe-cnc-machining", "/wp-content/uploads/2026/02/PTFE-55x55-1.jpg"],
      ["PEI / ULTEM", "/materials/ultem-cnc-machining", "/wp-content/uploads/2026/02/Ultem-55x55-1.jpg"],
    ],
  },
].map((tab) => ({
  ...tab,
  items: tab.items.map(([label, href, image]) => ({ label, href, image })),
}));

const homeMaterials = materialTabs.map((group, index) => ({
  ...group,
  visuals: index === 0 ? [
    {src: "/assets/images/stainless-steel-material-768x768.webp", alt: "Stainless steel sheet stock"},
    {src: "/assets/images/material-swiss-machining-brass-768x768.webp", alt: "Golden brass sheet stock"},
    {src: "/assets/images/copper-cnc-machining-material-768x768.webp", alt: "Reddish copper sheet stock"},
    {src: "/assets/images/titanium-alloy-machining-material.webp", alt: "Titanium alloy round bar stock"},
  ] : [
    {src: "/assets/images/cnc-engineering-plastics-assortment.webp", alt: "Illustrative assortment of engineering plastic rods, blocks and sheets in white, black, tan, amber and clear finishes"},
  ],
  caption: index === 0 ? "Stainless steel, brass, copper & titanium · Material examples" : "Engineering plastics · Illustration of rod, block & sheet stock",
}));

const parts = [
  {slug: "metal-enclosures", category: "HOUSINGS & ENCLOSURES", image: "/assets/images/cnc-electronic-housings.webp", name: "Machined Enclosures", feature: "Pockets, mounting faces and connector interfaces for equipment housings.", alt: "Precision machined metal housings with pockets and mounting interfaces"},
  {slug: "heat-sinks", category: "THERMAL COMPONENTS", image: "/assets/images/cnc-heat-sink.webp", name: "Heat Sinks", feature: "Finned bases and mounting surfaces for thermal assemblies.", alt: "Machined finned aluminum heat sink"},
  {slug: "bearing-housing", category: "BEARING COMPONENTS", image: "/assets/images/custom-bearing-housing-overview.webp", name: "Bearing Housings", feature: "Bearing seats, precision bores and mounting faces made to drawing.", alt: "Machined bearing housing with a raised precision bore"},
  {slug: "aerospace-fittings", category: "STRUCTURAL FITTINGS", image: "/assets/images/aerospace-5-axis-aluminum-structural-fitting.webp", name: "Structural Fittings", feature: "Multi-face brackets and fittings with intersecting bores and angled faces.", alt: "Complex aluminum structural fitting with multiple machined faces"},
  {slug: "cnc-machined-flange", category: "FLUID & MOUNTING INTERFACES", image: "/assets/images/aluminum-flange-product-overview-v1.webp", name: "Machined Flanges", feature: "Concentric bores, bolt patterns and sealing faces for assembled systems.", alt: "Precision machined metal flange with central bore and bolt holes"},
  {slug: "aerospace-connector-pins", category: "ELECTRICAL CONTACTS", image: "/assets/images/aluminum-connector-pins-white-v1.webp", name: "Connector Pins", feature: "Turned contact pins with mating surfaces, shoulders and solder cups.", alt: "Assorted machined electrical connector contact pins"},
].map(part => ({...part, href: `/custom-cnc-parts/${part.slug}`}));

const projectSteps = [
  {
    "title": "Review",
    "checkpoint": "DRAWING REVIEW",
    "text": "Check the drawing revision, material, functional dimensions and finish."
  },
  {
    "title": "Plan",
    "checkpoint": "PROCESS ROUTE",
    "text": "Define the machining route, datum scheme, fixtures and tool access."
  },
  {
    "title": "Prove",
    "checkpoint": "FIRST ARTICLE",
    "text": "Set up the part and inspect the first article before batch production."
  },
  {
    "title": "Produce",
    "checkpoint": "IN-PROCESS",
    "text": "Machine the batch with in-process checks and agreed finishing."
  },
  {
    "title": "Inspect & Pack",
    "checkpoint": "FINAL INSPECTION",
    "text": "Complete final checks, protect the parts and prepare them for shipment."
  }
];

const faqs = [
  {
    "question": "Which CNC machining process fits my part?",
    "answer": "Swiss machining is a useful starting point for small bar-stock parts with slender sections or fine features. CNC turning and milling suits parts that combine cylindrical surfaces with milled or drilled features. Send your drawing so the process can be reviewed against material, geometry, quantity and inspection needs."
  },
  {
    "question": "What tolerances can you quote?",
    "answer": "Specify the tolerances, datums and surface finish that the part needs to function. Feasibility is reviewed feature by feature because material, geometry, workholding and measurement access affect the result. The accepted drawing and quotation define the requirements for your order."
  },
  {
    "question": "Which materials can I request?",
    "answer": "Material guides cover metals such as stainless steel, aluminum, brass and titanium, and engineering plastics such as PEEK and POM. State the exact grade and stock condition in your request; availability and suitability must be confirmed for the particular part."
  },
  {
    "question": "How are quantity and delivery time confirmed?",
    "answer": "Include the initial quantity, likely repeat demand, target date and destination. Material availability, setup, machining, finishing and inspection affect cost and timing. Batch size and any expedited schedule are confirmed with the quotation."
  },
  {
    "question": "Can I request certification and inspection documents?",
    "answer": "Yes, include the required standard, report type, material records and traceability scope with your enquiry. Availability and applicability must be confirmed before ordering. If supplier certification is mandatory, request the current certificate and check that its scope meets your project requirements."
  }
];

const learningPosts = [
  {
    title: "What is Swiss Machining?",
    href: "/blog/swiss-machining",
    image: "/wp-content/uploads/2025/12/swiss-machining.png",
    excerpt:
      "Learn how guide-bushing support close to the cutting tool helps with small, slender bar-stock parts.",
  },
  {
    title: "CNC Lathe vs Mill",
    href: "/blog/cnc-lathe-vs-mill",
    image: "/wp-content/uploads/2025/12/cnc-turning-and-milling.png",
    excerpt:
      "Compare turning and milling, the features each process suits, and when a component needs both.",
  },
  {
    title: "CNC Machining Materials: A Comprehensive Guide",
    href: "/blog/cnc-machining-materials",
    image: "/wp-content/uploads/2025/12/cnc-machining-materials.png",
    excerpt:
      "CNC machining can be applied to a wide variety of materials, including but not limited to metals, plastics, and composites.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <div class="home-hero__inner">
        <div class="home-hero__copy">
          <p class="home-hero__eyebrow" data-no-contextual-links>CNC MILLING · TURNING · SWISS MACHINING</p>
          <h1 id="home-hero-title">Custom CNC Machining Services</h1>
          <p class="home-hero__tagline">Your Parts. Made to Your Specs.</p>
          <p>
            Get your metal and plastic parts machined to your drawing—from housings and brackets
            to precision shafts and fittings. Coordinate machining, finishing and inspection through one point of contact.
          </p>
          <ul class="home-hero__bullets">
            {heroBullets.map((item) => <li>{item === "General Tolerance ±0.01 mm" ? <>General Tolerance <strong>±0.01 mm</strong></> : item}</li>)}
          </ul>
          <div class="home-hero__actions">
            <a class="home-button" href="/cnc-machining-quote">Get a Quote for Your Parts <span aria-hidden="true">→</span></a>
            <a class="home-hero__secondary" href="/services">Explore Our Capabilities <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <figure class="home-hero__visual">
          <img src="/assets/images/cnc-machined-components-hero.webp" alt="Illustration of CNC milled housing and bracket with turned flange, shaft, brass bushing and plastic component" width="1000" height="667" loading="eager" fetchpriority="high" decoding="async" />
          <figcaption>Component geometry illustration · Housings, shafts, flanges &amp; bushings</figcaption>
        </figure>
      </div>
    </section>

    <nav class="home-section-nav" aria-label="On this page">
      <div class="home-section-nav__inner">
        <a href="#machining-processes">Capabilities</a>
        <a href="#equipment-quality">Equipment &amp; Quality</a>
        <a href="#materials">Materials</a>
        <a href="#surface-finishing">Surface Finishing</a>
        <a href="#machined-parts">Part Types</a>
        <a href="#production-workflow">Workflow</a>
        <a href="#home-faq">FAQs</a>
      </div>
    </nav>

    <section class="home-section home-services" id="machining-processes" aria-labelledby="processes-title">
      <h2 id="processes-title">CNC Machining Capabilities</h2>
      <p class="home-section__intro">Choose a process based on your part’s geometry and features. We machine custom components from drawings for prototype and production orders.</p>
      <div class="home-service-grid">
        {services.map((service) => (
          <article class="home-service-card">
            <a class="home-service-card__image" href={service.href} aria-label={service.title}>
              <img src={service.image} alt={service.alt || service.title} width={service.width || 540} height={service.height || 260} loading="lazy" />
            </a>
            <div class="home-service-card__body">
              <h3><a href={service.href}>{service.title}</a></h3>
              <p>{service.text}</p>
              <div class="home-service-card__links">
                <a href={service.href}>{service.label} <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="home-section home-equipment" id="equipment-quality" aria-labelledby="equipment-quality-title">
      <div class="home-equipment__header">
        <div class="home-equipment__copy">
          <p class="home-equipment-kicker">FACTORY CAPACITY</p>
          <h2 id="equipment-quality-title">Equipment &amp; Quality Control</h2>
          <p>Documented production and measurement resources support drawing-based manufacturing and inspection.</p>
        </div>
        <div class="home-equipment-stats" aria-label="Equipment register totals">
          <div class="home-equipment-stat"><strong>86</strong><span>CNC machines in the turning &amp; milling register</span></div>
          <div class="home-equipment-stat"><strong>122</strong><span>measurement instruments in the calibration plan</span></div>
        </div>
      </div>
      <div class="home-equipment-grid">
        <article class="home-equipment-card"><div class="home-equipment-card__visual"><img src="/assets/images/cnc-machining-center-schematic.webp" alt="Schematic illustration of a CNC machining center" loading="lazy" decoding="async" /><span class="home-equipment-card__visual-caption caption">Equipment schematic</span></div><div class="home-equipment-card__body"><div class="home-equipment-card__meta"><p class="home-equipment-kicker">MILLING</p><span class="home-card-number" aria-hidden="true">01</span></div><h3>CNC Machining Centers</h3><p>CNC machining centers handle prismatic and multi-face parts, with the machining route selected against the drawing requirements.</p></div></article>
        <article class="home-equipment-card"><div class="home-equipment-card__visual"><img src="/assets/images/cnc-mill-turn-schematic.webp" alt="Schematic illustration of a CNC mill-turn machine" loading="lazy" decoding="async" /><span class="home-equipment-card__visual-caption caption">Equipment schematic</span></div><div class="home-equipment-card__body"><div class="home-equipment-card__meta"><p class="home-equipment-kicker">TURNING &amp; SWISS-TYPE</p><span class="home-card-number" aria-hidden="true">02</span></div><h3>Lathes &amp; Mill-Turn Centers</h3><p>Turning and Swiss-type equipment supports turned profiles, slender shafts and parts with milled features.</p></div></article>
        <article class="home-equipment-card"><div class="home-equipment-card__visual"><img src="/assets/images/dimensional-inspection-schematic.webp" alt="Schematic illustration of coordinate measurement equipment" loading="lazy" decoding="async" /><span class="home-equipment-card__visual-caption caption">Equipment schematic</span></div><div class="home-equipment-card__body"><div class="home-equipment-card__meta"><p class="home-equipment-kicker">DIMENSIONAL INSPECTION</p><span class="home-card-number" aria-hidden="true">03</span></div><h3>CMM, OMM &amp; Gauges</h3><p>Coordinate and optical measuring machines, contour instruments and height gauges support checks against drawing requirements.</p></div></article>
      </div>
      <div class="home-equipment__footer"><span>Inspection scope is matched to the critical dimensions and records specified for each order.</span><a href="/resources/equipment-list">View Equipment List <span aria-hidden="true">→</span></a></div>
    </section>

    <section class="home-section home-materials" id="materials" aria-labelledby="home-materials-title" data-home-tabs>
      <h2 id="home-materials-title">Materials for CNC Machining</h2>
      <p class="home-section__intro">Explore metals and engineering plastics for your custom CNC parts. Select a material to learn more about its machining options and applications.</p>
      <div class="home-tabs" role="tablist" aria-label="CNC machining materials" hidden>
        {homeMaterials.map((tab, index) => (
          <button
            class:list={["home-tab", index === 0 && "is-active"]}
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            aria-controls={`home-material-panel-${index}`}
            id={`home-material-tab-${index}`}
            data-home-tab={index}
          >
            {tab.label}
          </button>
        ))}
      </div>
      <div class="home-material-panels">
        {homeMaterials.map((tab, index) => (
          <div
            class="home-material-panel"
            id={`home-material-panel-${index}`}
            data-home-panel={index}
          >
            <h3 class="home-material-fallback">{tab.label}</h3>
            <div class="home-material-display">
              <figure>
                <div
                  class="home-material-visual"
                  style={tab.visuals.length > 1
                    ? "display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: clamp(8px, 1vw, 12px); width: 100%; aspect-ratio: 1 / 1; overflow: hidden;"
                    : "width: 100%; aspect-ratio: 1 / 1; overflow: hidden;"}
                >
                  {tab.visuals.map(visual => <img src={visual.src} alt={visual.alt} width="768" height="768" loading="lazy" decoding="async" style="display: block; width: 100%; height: 100%; min-width: 0; min-height: 0; object-fit: cover;" />)}
                </div>
                <figcaption>{tab.caption}</figcaption>
              </figure>
              <div class="home-material-details">
                <ul class="home-material-links" aria-label={tab.label}>{tab.items.map(item => <li><a href={item.href}><span>{item.label}</span></a></li>)}</ul>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="home-section-footer"><p>Match material, geometry and finish to your application.</p><a class="home-text-link" href="/materials">Explore All CNC Materials <span aria-hidden="true">→</span></a></div>
    </section>

    <section class="home-section home-finishing" id="surface-finishing" aria-labelledby="home-finishing-title">
      <h2 id="home-finishing-title">Surface Finishing for CNC Machined Parts</h2>
      <p class="home-section__intro">Get machining and finishing through one point of contact. Choose a finish for the appearance, wear or corrosion requirements of your part.</p>
      <div class="home-finishing-display">
        <figure><img src="/assets/images/surface-finishing-semiconductor.webp" alt="Close-up of a metal component with reflective and fine-textured surfaces" width="1168" height="784" loading="lazy" decoding="async" /><figcaption>Machined metal surface · Finish detail</figcaption></figure>
        <div class="home-finishing-options"><h3>Finishing Options</h3><ul>{finishes.map(finish => <li><span aria-hidden="true">✓</span>{finish}</li>)}</ul><p class="body-small">Include the color, coating thickness, masking areas and final dimensional requirements with your drawing. Compatibility is reviewed for the selected material and grade.</p></div>
      </div>
      <div class="home-section-footer"><a class="home-text-link" href="/blog/surface-finish">Read the Surface Finish Guide <span aria-hidden="true">→</span></a></div>
    </section>

    <section class="home-section home-parts" id="machined-parts" aria-labelledby="machined-parts-title">
      <h2 id="machined-parts-title">Explore Machined Component Types</h2>
      <p class="home-section__intro">
        Explore product examples across equipment housings, thermal parts, structural fittings, flanges and electrical contacts.
      </p>
      <div class="home-component-grid">
        {parts.map((part, index) => (
          <article class="home-component">
            <a class="home-component__link" href={part.href} aria-labelledby={`component-${part.slug}`}>
              <div class="home-component__visual">
                <img src={part.image} alt={part.alt} width="640" height="480" loading="lazy" decoding="async" />
                <span class="home-component__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              </div>
              <div class="home-component__body">
                <p class="home-component__category">{part.category}</p>
                <h3 id={`component-${part.slug}`}>{part.name}</h3>
                <p>{part.feature}</p>
                <span class="home-component__action">View Product Details <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>
        ))}
      </div>
      <div class="home-parts__footer">
        <p>Explore component geometries and their machining considerations.</p>
        <div><a class="home-text-link" href="/custom-cnc-parts">Browse All Custom Parts <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="home-section home-project-steps" id="production-workflow" aria-labelledby="home-project-steps-title">
      <div class="home-process-heading">
        <div class="home-process-heading__copy"><p class="home-process-kicker">PRODUCTION WORKFLOW</p><h2 id="home-project-steps-title">From Drawing to Delivery</h2><p>A clear sequence. Defined checks at each stage.</p></div>
        <dl class="home-process-timing" aria-label="Reference production windows"><div><dt>Samples</dt><dd><strong>3–5</strong><span>working days</span></dd></div><div><dt>Batches</dt><dd><strong>7–15</strong><span>working days</span></dd></div></dl>
      </div>
      <ol class="home-process-grid">
        {projectSteps.map((item, index) => (
          <li class="home-process-step">
            <span class="home-process-step-number">0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <span class="home-process-step__checkpoint-kicker">CHECK · {item.checkpoint}</span>
          </li>
        ))}
      </ol>
      <div class="home-process-footer">
        <p class="home-process-footer__note">Final timing depends on material, quantity, complexity, finishing and inspection. Transit time is separate.</p>
        <a class="home-process-footer__action" href="/cnc-machining-quote">Send a drawing for review <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="home-faq" id="home-faq">
      <div class="home-faq__inner">
        <h2>CNC Machining Questions</h2>
        <div class="home-faq__list">
          {faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section home-learning">
      <h2>CNC Machining Learning Center</h2>
      <div class="home-learning-grid">
        {learningPosts.map((post, index) => (
          <article class="home-learning-card">
            <a class="home-learning-card__image" href={post.href} tabindex="-1">
              <img src={post.image} alt={post.title} width="360" height="220" loading="lazy" />
            </a>
            <div class="home-learning-card__body">
              <div class="home-learning-card__meta" aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span><i></i></div>
              <div class="home-learning-card__title-row"><h3><a href={post.href}>{post.title}</a></h3><span class="home-learning-card__arrow" aria-hidden="true">→</span></div>
