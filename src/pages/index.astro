  <script is:inline>
    for (const root of document.querySelectorAll("[data-home-tabs]")) {
      const tabs = Array.from(root.querySelectorAll("[data-home-tab]"));
      const panels = Array.from(root.querySelectorAll("[data-home-panel]"));

      const activate = (tab, focus = false) => {
          const activeIndex = tab.getAttribute("data-home-tab");
          tabs.forEach((item) => {
            const active = item.getAttribute("data-home-tab") === activeIndex;
            item.classList.toggle("is-active", active);
            item.setAttribute("aria-selected", String(active));
            item.tabIndex = active ? 0 : -1;
          });
          panels.forEach((panel) => {
            panel.hidden = panel.getAttribute("data-home-panel") !== activeIndex;
          });
          if (focus) tab.focus();
      };
      panels.forEach((panel, index) => {
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("aria-labelledby", `home-material-tab-${index}`);
        panel.tabIndex = 0;
      });
      root.querySelectorAll(".home-material-fallback").forEach(heading => heading.hidden = true);
      root.querySelector('[role="tablist"]').hidden = false;
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(tab));
        tab.addEventListener("keydown", event => {
          let next;
          if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") next = (index + tabs.length - 1) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault();
          activate(tabs[next], true);
        });
      });
      activate(tabs[0]);
    }

  </script>
