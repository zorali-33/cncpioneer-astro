---
import PartsLibrary from "../../../components/native/PartsLibrary.astro";
import { catalogPageCount } from "../../../parts-catalog-native.mjs";
export function getStaticPaths() {
  return Array.from({ length: catalogPageCount - 1 }, (_, index) => ({
    params: { page: String(index + 2) }, props: { page: index + 2 },
  }));
}

const { page } = Astro.props;
---

<PartsLibrary page={page} />
