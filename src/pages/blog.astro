---
import SiteHeader from "../components/native/SiteHeader.astro";
import SiteFooter from "../components/native/SiteFooter.astro";
import { decodeHTML } from "entities";
import SiteHeaderSpacer from "../components/native/SiteHeaderSpacer.astro";
import { getReviewedSeo } from "../data/pageSeoOverrides.mjs";
const seo = getReviewedSeo("/blog");
import QuoteCta from "../components/native/QuoteCta.astro";
import '../styles/blog-native.css';
import { getBlogArticles, postsPerPage } from '../blog-archive.mjs';
import BlogExplore from '../components/native/BlogExplore.astro';
import BlogCategoryLabel from '../components/native/BlogCategoryLabel.astro';

const blogPages = import.meta.glob('../mirrored-pages/blog/*/index.html', { query: '?raw', import: 'default', eager: true });
const articles = getBlogArticles(blogPages);
const lastPage = Math.ceil(articles.length / postsPerPage);


const featuredImageMetadata = [
  {
    title: 'Top 20 5 Axis CNC Machining Manufacturers in China (2026)',
    href: '/blog/5-axis-cnc-machining-manufacturers-in-china',
    image: '/wp-content/uploads/2026/09/5-axis-cnc-machining.png',
    alt: '5 axis cnc machining',
    width: 510,
    height: 335,
    priority: true
  },
  {
    title: 'Complete Engineering Guide to Robot Hands',
    href: '/blog/robot-hands',
    image: '/wp-content/uploads/2026/07/Inspire-RH56DFX-hands.jpg',
    alt: 'Inspire RH56DFX hands',
    width: 680,
    height: 380,
    priority: true
  },
  {
    title: 'Building a Humanoid Robot with CNC Machined Parts',
    href: '/blog/building-a-humanoid-robot',
    image: '/wp-content/uploads/2026/07/humanoid-robots-structure.jpg',
    alt: 'humanoid robots structure',
    width: 680,
    height: 380
  },
  {
    title: 'Top 20 China Humanoid Robot Companies to Know in 2026',
    href: '/blog/china-humanoid-robot-companies',
    image: '/wp-content/uploads/2026/07/china-humanoid-robot.jpg',
    alt: 'china humanoid robot',
    width: 405,
    height: 272
  },
  {
    title: 'CNC Locating Pins: Precision Workholding and Fixture Design',
    href: '/blog/cnc-locating-pins',
    image: '/wp-content/uploads/2026/04/3-2-1-locating-principle-diagram.webp',
    alt: '3 2 1 locating principle diagram',
    width: 1168,
    height: 784
  },
  {
    title: 'CNC Machining for Semiconductor Industry',
    href: '/blog/cnc-machining-for-semiconductor-industry',
    image: '/wp-content/uploads/2026/04/semiconductor-cnc-machining-parts.webp',
    alt: 'high precision CNC machined semiconductor components aluminum stainless steel',
    width: 1168,
    height: 784
  },
  {
    title: 'Precision Aerospace CNC Machined Parts: Materials, Processes, Tolerances, and Design',
    href: '/blog/precision-aerospace-cnc-machined-parts',
    image: '/wp-content/uploads/2026/03/cmm-inspection.webp',
    alt: 'CMM Inspection Close-up',
    width: 1168,
    height: 784
  },
  {
    title: 'Precision CNC Milling Parts: Tolerances, Materials, DFM & Applications',
    href: '/blog/precision-cnc-milling-parts',
    image: '/wp-content/uploads/2026/03/precision-cnc-milling-5axis.webp',
    alt: '5-axis CNC milling machine producing high-precision parts',
    width: 1168,
    height: 784
  },
  {
    title: 'CNC Precision Parts Guide : Tolerances, Materials, DFM & Applications',
    href: '/blog/cnc-precision-parts',
    image: '/wp-content/uploads/2026/03/cnc-precision-parts-workshop-5-axis.webp',
    alt: 'cnc precision parts workshop 5 axis',
    width: 1168,
    height: 784
  }
];

const posts = articles.slice(0, postsPerPage).map((article, index) => ({
  ...featuredImageMetadata.find((item) => item.href === `/blog/${article.slug}`),
  title: decodeHTML(article.displayTitle || article.title),
  href: `/blog/${article.slug}`,
  image: article.image,
  alt: decodeHTML(article.displayTitle || article.title),
  priority: index < 2,
}));

---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="profile" href="https://gmpg.org/xfn/11" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />



    <link rel="preload" as="image" href="/wp-content/uploads/2026/07/Inspire-RH56DFX-hands.jpg" fetchpriority="high" />
    <link rel="canonical" href="https://www.cncpioneer.com/blog" />
    <link rel="next" href="/blog/page/2" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content="https://www.cncpioneer.com/blog" />
    <meta property="og:site_name" content="CNCPioneer" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/wp-content/uploads/2026/01/cropped-site-icon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/wp-content/uploads/2026/01/cropped-site-icon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2026/01/cropped-site-icon-180x180.png" />
    <meta name="msapplication-TileImage" content="/wp-content/uploads/2026/01/cropped-site-icon-270x270.png" />
  </head>
  <body class="blog-page">
    <SiteHeader />
    <SiteHeaderSpacer />

    <main id="content" class="site-main">
      <section class="blog-hero" aria-labelledby="blog-title">
        <div class="blog-hero-inner">
          <p id="breadcrumbs" class="blog-breadcrumbs"><span><a href="/">Home</a></span> <span aria-hidden="true">&raquo;</span> <span aria-current="page">Blog</span></p>
          <h1 id="blog-title">Blog</h1>
          <p class="blog-intro">Explore digital manufacturing: expert resources, in-depth articles, and the latest industry updates.</p>
        </div>
      </section>

      <BlogExplore articles={articles} search topics />
      <section class="blog-grid-section" aria-labelledby="blog-posts-title">
        <h2 id="blog-posts-title" class="blog-latest-heading">Latest Articles</h2>
        <div class="blog-grid" role="list">
          {posts.map((post) => (
            <article class="blog-post-card" role="listitem">
              <a class="blog-post-thumbnail-link" href={post.href} tabindex="-1">
                <span class="blog-post-thumbnail">
                  <img
                    src={post.image}
                    width={post.width}
                    height={post.height}
                    alt={post.alt}
                    decoding="async"
                    loading={post.priority ? 'eager' : 'lazy'}
                    fetchpriority={post.priority ? 'high' : undefined}
                  />
                </span>
              </a>
              <div class="blog-post-text">
                <BlogCategoryLabel slug={post.href.split('/').pop()}/>
                <h3 class="blog-post-title"><a href={post.href}>{post.title}</a></h3>
                <a class="blog-read-more" href={post.href} aria-label={`Read more about ${post.title}`} tabindex="-1">Read More</a>
              </div>
            </article>
          ))}
        </div>
        <nav class="blog-pagination" aria-label="Pagination">
          <span class="page-numbers prev"></span>
          <span aria-current="page" class="page-numbers current"><span class="screen-reader-only">Page</span>1</span>
          <a class="page-numbers" href="/blog/page/2"><span class="screen-reader-only">Page</span>2</a>
          <a class="page-numbers" href="/blog/page/3"><span class="screen-reader-only">Page</span>3</a>
          <span class="page-numbers dots">&hellip;</span>
          <a class="page-numbers" href={`/blog/page/${lastPage}`}><span class="screen-reader-only">Page</span>{lastPage}</a>
          <a class="page-numbers next" href="/blog/page/2">Next &raquo;</a>
        </nav>
      </section>

      <QuoteCta id="blog-quote" idPrefix="blog-quote-form" formName="Blog Project Enquiry" kicker="PLAN YOUR PROJECT" title="Discuss your next CNC project" description="Share your drawing, material, quantity and inspection requirements for a project-specific review." />
    </main>

    <SiteFooter />
  </body>
</html>
