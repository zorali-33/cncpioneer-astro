---
import SiteHeaderSpacer from "../../components/native/SiteHeaderSpacer.astro";
import IndustryNavigation from '../../components/native/IndustryNavigation.astro';
import NavigationMaterialGroup from '../../components/native/NavigationMaterialGroup.astro';
import {getSiteNavigation} from '../../data/siteNavigation.mjs';
import { getReviewedSeo } from "../../data/pageSeoOverrides.mjs";
const seo = getReviewedSeo("/author/ryan-wang");
import SiteSearch from "../../components/native/SiteSearch.astro";
import '../../styles/blog-native.css';
import '../../styles/author-native.css';
import { getBlogArticles } from '../../blog-archive.mjs';
import { getAuthorPostsPerPage, getAuthorArchivePosts, renderAuthorLoadMoreAnchor, renderAuthorPagination } from '../../author-archive.mjs';

const blogPages = import.meta.glob('../../mirrored-pages/blog/*/index.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const authorBio = 'Ryan Wang is the CNC Machining Expert at Cncpioneer, with over 15 years of hands-on experience as a CNC programmer, process engineer, senior machinist, and precision manufacturing specialist. He has helped companies in aerospace, automotive, medical, and electronics sectors achieve micron-level tolerances and scale from prototypes to high-volume production. Ryan is also an experienced instructor in advanced CNC techniques, particularly five-axis machining and challenging materials.';
const ryanArticles = getBlogArticles(blogPages).filter((article) => article.authorSlug === 'ryan-wang');
const lastPage = Math.ceil(ryanArticles.length / getAuthorPostsPerPage('ryan-wang'));
const loadMoreAnchorHtml = renderAuthorLoadMoreAnchor('ryan-wang', 1, lastPage);
const paginationHtml = renderAuthorPagination('ryan-wang', 1, lastPage);

const navItems = getSiteNavigation(Astro.url.pathname);

const posts = getAuthorArchivePosts(ryanArticles, 'ryan-wang');

const footerColumns = [
  {
    heading: 'Services',
    links: [
      { label: 'Swiss Machining Service', href: '/services/swiss-machining' },
      { label: 'CNC Turning and Milling  Service', href: '/services/cnc-turning-and-milling' }
    ]
  },
  {
    heading: 'Industries',
    links: [
      { label: 'Aerospace', href: '/industries/aerospace' },
      { label: 'Defense', href: '/industries/defense' },
      { label: 'Medical', href: '/industries/medical' },
      { label: 'Semiconductor', href: '/industries/semiconductor' },
      { label: 'Consumer Electronics', href: '/industries/consumer-electronics' },
      { label: 'Oil & Gas', href: '/industries/oil-gas' },
      { label: 'Automotive', href: '/industries/automotive' },
      { label: 'Railway', href: '/industries/railway' }
    ]
  },
  {
    heading: 'About',
    links: [
      { label: 'About Us', href: '/about-us' },
      { label: 'Blog', href: '/blog' }
    ]
  }
];

const personJsonLd = JSON.stringify([{
  '@context': 'https://schema.org/',
  '@type': 'Person',
  name: 'Ryan Wang',
  url: 'https://www.cncpioneer.com/author/ryan-wang',
  sameAs: ['http://www.cncpioneer.com'],
  description: authorBio
}]);
---

<!doctype html>
<html lang="en-US" class="author-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="profile" href="https://gmpg.org/xfn/11" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />



    <link rel="canonical" href="https://www.cncpioneer.com/author/ryan-wang" />
    <link rel="next" href="https://www.cncpioneer.com/author/ryan-wang/page/2" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content="https://www.cncpioneer.com/author/ryan-wang" />
    <meta property="og:site_name" content="CNCPioneer" />
    <meta property="og:image" content="https://secure.gravatar.com/avatar/cce2715f1891c236d55b31c5be14173bd51ad76c7664cf39b084d84aafecc9e0?s=500&d=mm&r=g" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/wp-content/uploads/2026/01/cropped-site-icon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/wp-content/uploads/2026/01/cropped-site-icon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2026/01/cropped-site-icon-180x180.png" />
    <meta name="msapplication-TileImage" content="/wp-content/uploads/2026/01/cropped-site-icon-270x270.png" />
    <script type="application/ld+json" set:html={personJsonLd}></script>
  </head>
  <body class="author-page archive author author-ryan-wang author-1">
    <header class="site-header">
      <div class="topbar">
        <div class="topbar-inner">
          <div class="topbar-contact" aria-label="Contact details">
            <span class="topbar-item">
              <svg viewBox="0 0 512 512" aria-hidden="true"><path d="M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.7-98.9 140.5-177.2 177.2l-49.6-60.6c-6.8-8.3-18.2-11.1-28-6.9l-112 48C3.9 366.5-2 378.1.6 389.4l24 104C27.1 504.2 36.7 512 48 512c256.1 0 464-207.5 464-464 0-11.2-7.7-20.9-18.6-23.4z"></path></svg>
              +8613725562746
            </span>
            <span class="topbar-item">
              <svg viewBox="0 0 512 512" aria-hidden="true"><path d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z"></path></svg>
              info@cncpioneer.com
            </span>
          </div>
          <div class="topbar-actions">
            <button class="icon-button" aria-label="Search">
              <svg viewBox="0 0 512 512" aria-hidden="true"><path d="M505 442.7 405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128 0-70.7 57.2-128 128-128 70.7 0 128 57.2 128 128 0 70.7-57.2 128-128 128z"></path></svg>
            </button>
          </div>
        </div>
      </div>
      <div class="mainnav">
        <div class="nav-inner">
          <a class="brand" href="/" aria-label="CNC Pioneer home">
            <img src="/wp-content/uploads/2025/11/cncpioneer_nav_logo.png" alt="CNC Pioneer" width="160" height="35" />
          </a>
          <input class="menu-state" type="checkbox" id="menu-state" aria-hidden="true" />
          <label class="menu-toggle" for="menu-state" aria-label="Menu Toggle">
            <span></span>
            <span></span>
            <span></span>
          </label>
          <nav class="primary-nav" aria-label="Menu">
            <ul>
              {navItems.map((item) => (
                <li class:list={[item.children && 'has-submenu']}>
                  {item.href ? <a href={item.href} aria-current={item.active ? (Astro.url.pathname === item.href ? 'page' : 'location') : undefined}>
                    {item.label}{item.children && <span class="caret" aria-hidden="true"></span>}
                  </a> : <button class="nav-label-button" data-dropdown-trigger type="button" aria-expanded="false" aria-controls={item.id + '-submenu'}>{item.label}<span class="caret" aria-hidden="true"></span></button>}
                  {item.children && (
                    <ul class="submenu" id={(item.id || item.href.slice(1)) + "-submenu"}>
                      {item.href === '/industries' ? <li class="industry-menu-content"><IndustryNavigation /></li> : item.children.map((child) => (
                        <li>{child.children ? <NavigationMaterialGroup group={child} /> : <a href={child.href}>{child.label}</a>}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </header>
    <SiteHeaderSpacer />

    <main id="content" class="author-main">
      <section class="author-wrap" aria-labelledby="author-name">
        <a class="author-avatar" href="/author/ryan-wang">
          <img src="/wp-content/uploads/2026/03/ryan-wang-100X100.jpg" width="100" height="100" alt="Picture of Ryan Wang" />
        </a>
        <div class="author-text">
          <a class="author-name-link" href="/author/ryan-wang">
            <h1 id="author-name" class="author-name">Ryan Wang</h1>
          </a>
          <div class="author-bio">
            <p>{authorBio}</p>
          </div>
        </div>
      </section>

      <section class="author-archive" aria-labelledby="author-articles-heading">
        <h2 id="author-articles-heading" class="archive-heading">All Articles From The Author</h2>
        <div class="author-posts-section">
          <div class="author-posts-grid" role="list">
            {posts.map((post) => (
              <article class="author-post-card" role="listitem">
                <a class="author-post-thumb-link" href={post.href} tabindex="-1">
                  <span class="author-post-thumb">
                    <img
                      src={post.image}
                      width={post.width}
                      height={post.height}
                      alt={post.alt}
                      decoding="async"
                      loading={post.priority ? 'eager' : 'lazy'}
                      fetchpriority={post.priority ? 'high' : undefined}
                    />
                  </span>
                </a>
                <div class="author-post-text">
                  <h3 class="author-post-title"><a href={post.href}>{post.title}</a></h3>
                  <span class="author-post-date">{post.date}</span>
                  <a class="author-read-more" href={post.href} aria-label={`Read more about ${post.title}`} tabindex="-1">Read More &raquo;</a>
                </div>
              </article>
            ))}
          </div>
          <Fragment set:html={loadMoreAnchorHtml} />
          <Fragment set:html={paginationHtml} />
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-inner">
          {footerColumns.map((column) => (
            <section class="footer-column" aria-labelledby={`footer-${column.heading.trim().toLowerCase().replace(/\s+/g, '-') || 'about'}`}>
              <h2 id={`footer-${column.heading.trim().toLowerCase().replace(/\s+/g, '-') || 'about'}`}>{column.heading}</h2>
              <ul>
                {column.links.map((link) => (
                  <li><a href={link.href}>{link.label}</a></li>
                ))}
              </ul>
            </section>
          ))}
          <section class="footer-column contact-column" aria-labelledby="footer-contact">
            <h2 id="footer-contact">Get In Touch</h2>
            <p>Room 1202B54, 12th Floor, Tairan Cangsong Building, No. 25,<br />Futian District, Shenzhen, China</p>
            <ul>
              <li><a href="mailto:info@cncpioneer.com">Email: info@cncpioneer.com</a></li>
              <li><a href="tel:+8613725562746">Phone: +8613725562746 </a></li>
              <li>Hours: Mon-Fri 9:00AM - 6:00PM</li>
            </ul>
          </section>
        </div>
      </div>
      <div class="copyright">
        <p>Copyright &copy; 2026 CNCPioneer All Rights Reserved.</p>
      </div>
    </footer>
    <SiteSearch />
  </body>
</html>
