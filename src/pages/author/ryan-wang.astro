---
import SiteHeader from "../../components/native/SiteHeader.astro";
import SiteFooter from "../../components/native/SiteFooter.astro";
import SiteHeaderSpacer from "../../components/native/SiteHeaderSpacer.astro";
import { getReviewedSeo } from "../../data/pageSeoOverrides.mjs";
const seo = getReviewedSeo("/author/ryan-wang");
import '../../styles/blog-native.css';
import '../../styles/author-native.css';
import { getBlogArticles } from '../../blog-archive.mjs';
import { getAuthorPostsPerPage, getAuthorArchivePosts, renderAuthorLoadMoreAnchor, renderAuthorPagination } from '../../author-archive.mjs';

const blogPages = import.meta.glob('../../mirrored-pages/blog/*/index.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const authorBio = 'Ryan Wang is the CNC Machining Expert at Cncpioneer, with over 15 years of hands-on experience as a CNC programmer, process engineer, senior machinist, and precision manufacturing specialist. He has helped companies in aerospace, automotive, medical, and electronics sectors achieve micron-level tolerances and scale from prototypes to high-volume production. Ryan is also an experienced instructor in advanced CNC techniques, particularly five-axis machining and challenging materials.';
const ryanArticles = getBlogArticles(blogPages).filter((article) => article.authorSlug === 'ryan-wang');
const lastPage = Math.ceil(ryanArticles.length / getAuthorPostsPerPage('ryan-wang'));
const loadMoreAnchorHtml = renderAuthorLoadMoreAnchor('ryan-wang', 1, lastPage);
const paginationHtml = renderAuthorPagination('ryan-wang', 1, lastPage);


const posts = getAuthorArchivePosts(ryanArticles, 'ryan-wang');


const personJsonLd = JSON.stringify([{
  '@context': 'https://schema.org/',
  '@type': 'Person',
  name: 'Ryan Wang',
  url: 'https://www.cncpioneer.com/author/ryan-wang',
  sameAs: ['http://www.cncpioneer.com'],
  description: authorBio
}]);
---

<!doctype html>
<html lang="en-US" class="author-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="profile" href="https://gmpg.org/xfn/11" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />



    <link rel="canonical" href="https://www.cncpioneer.com/author/ryan-wang" />
    <link rel="next" href="https://www.cncpioneer.com/author/ryan-wang/page/2" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content="https://www.cncpioneer.com/author/ryan-wang" />
    <meta property="og:site_name" content="CNCPioneer" />
    <meta property="og:image" content="https://secure.gravatar.com/avatar/cce2715f1891c236d55b31c5be14173bd51ad76c7664cf39b084d84aafecc9e0?s=500&d=mm&r=g" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/wp-content/uploads/2026/01/cropped-site-icon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/wp-content/uploads/2026/01/cropped-site-icon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2026/01/cropped-site-icon-180x180.png" />
    <meta name="msapplication-TileImage" content="/wp-content/uploads/2026/01/cropped-site-icon-270x270.png" />
    <script type="application/ld+json" set:html={personJsonLd}></script>
  </head>
  <body class="author-page archive author author-ryan-wang author-1">
    <SiteHeader />
    <SiteHeaderSpacer />

    <main id="content" class="author-main">
      <section class="author-wrap" aria-labelledby="author-name">
        <a class="author-avatar" href="/author/ryan-wang">
          <img src="/wp-content/uploads/2026/03/ryan-wang-100X100.jpg" width="100" height="100" alt="Picture of Ryan Wang" />
        </a>
        <div class="author-text">
          <a class="author-name-link" href="/author/ryan-wang">
            <h1 id="author-name" class="author-name">Ryan Wang</h1>
          </a>
          <div class="author-bio">
            <p>{authorBio}</p>
          </div>
        </div>
      </section>

      <section class="author-archive" aria-labelledby="author-articles-heading">
        <h2 id="author-articles-heading" class="archive-heading">All Articles From The Author</h2>
        <div class="author-posts-section">
          <div class="author-posts-grid" role="list">
            {posts.map((post) => (
              <article class="author-post-card" role="listitem">
                <a class="author-post-thumb-link" href={post.href} tabindex="-1">
                  <span class="author-post-thumb">
                    <img
                      src={post.image}
                      width={post.width}
                      height={post.height}
                      alt={post.alt}
                      decoding="async"
                      loading={post.priority ? 'eager' : 'lazy'}
                      fetchpriority={post.priority ? 'high' : undefined}
                    />
                  </span>
                </a>
                <div class="author-post-text">
                  <h3 class="author-post-title"><a href={post.href}>{post.title}</a></h3>
                  <span class="author-post-date">{post.date}</span>
                  <a class="author-read-more" href={post.href} aria-label={`Read more about ${post.title}`} tabindex="-1">Read More &raquo;</a>
                </div>
              </article>
            ))}
          </div>
          <Fragment set:html={loadMoreAnchorHtml} />
          <Fragment set:html={paginationHtml} />
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
