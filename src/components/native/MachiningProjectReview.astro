---
const { kind } = Astro.props;
const swiss = kind === "swiss";
const examples = swiss ? [
  ["Connector pins", "Stepped diameters, contact tips and grooves. Identify mating dimensions and any plating allowance.", "/custom-cnc-parts/connector-pins"],
  ["Slender shafts and pins", "Support close to the cut can help control deflection. Specify straightness, runout and the datum axis.", "/custom-cnc-parts/cnc-machined-pins"],
  ["Threaded fittings", "Turned profiles with bores, threads or cross-holes. Flag burr-sensitive passages and sealing surfaces.", "/custom-cnc-parts/pipe-fittings"],
] : [
  ["Shafts with milled features", "Turned journals with flats, slots or cross-holes. Define how these features relate to the shaft datum.", "/custom-cnc-parts/stainless-steel-precision-turning-shaft"],
  ["Flanged components", "Turned faces and bores with drilled or milled features. Include the bolt pattern, face runout and locating dimensions.", "/custom-cnc-parts/stainless-steel-cnc-turning-flanges"],
  ["Fittings and adapters", "Internal and external threads, sealing faces and wrench flats. Identify thread standards and surface requirements.", "/custom-cnc-parts/brass-turning-milling-parts"],
];
const checks = swiss ? [
  ["Bar stock and geometry", "Material grade, stock condition, largest diameter, overall length and slender sections."],
  ["Fine features", "Minimum hole size, thread details, groove widths, wall thickness and burr limits."],
  ["Functional dimensions", "Datums, mating fits, straightness and runout; identify the features requiring inspection records."],
  ["Batch and finish", "Trial and repeat quantities, plating or heat treatment, and dimensions that apply after finishing."],
] : [
  ["Stock and workholding", "Material grade, largest diameter, length and thin walls; include finished-part and stock assumptions."],
  ["Turned and milled features", "Bore depths, thread standards, flats, slots and cross-holes; flag areas with restricted tool access."],
  ["Datum relationships", "Identify the common axis, locating faces, position tolerances and runout requirements."],
  ["Finishing and quantity", "State the batch size, heat treatment, coating and which dimensions apply after finishing."],
];
---
<section class="project-review" id={`${kind}-capabilities`} aria-labelledby={`${kind}-review-heading`}>
  <h2 id={`${kind}-review-heading`}>{swiss ? "Is Swiss machining right for your part?" : "Parts suited to CNC turning and milling"}</h2>
  <p class="project-review__intro">{swiss
    ? "Swiss machining is a useful starting point for small bar-stock parts with slender sections or repeated fine features. The examples below guide process selection; dimensions and inspection requirements still need drawing review."
    : "Turn-mill machining is a useful starting point when a component combines cylindrical surfaces with milled or drilled features. A combined process can reduce transfers between setups; tool access and workholding determine the actual sequence."}</p>
  <div class="project-review__examples">
    {examples.map(([title, text, href]) => <article><h3><a href={href}>{title}</a></h3><p>{text}</p></article>)}
  </div>
  <h3 class="project-review__subheading">What we review on your drawing</h3>
  <dl class="project-review__checks">
    {checks.map(([label, text]) => <div><dt>{label}</dt><dd>{text}</dd></div>)}
  </dl>
  <p class="project-review__note">Part size and tolerance feasibility are confirmed feature by feature. Send a dimensioned drawing so the process, any secondary operations and acceptance criteria can be agreed before ordering.</p>
  <div class="project-review__panels">
    <div>
      <h3>Agree the inspection plan</h3>
      <p>{swiss
        ? "Identify critical diameters, small bores, threads, burr-sensitive edges and surface finish. These features may need different measurement methods; access for inspection matters as much as access for cutting."
        : "Identify the datum axis, locating faces, bore fits, threads and the position of milled features. Specify how runout and feature relationships will be accepted, including any checks after finishing."}</p>
      <p>Include sampling or first-article requirements and the reports you need. Material records, traceability and any certification requirements must be confirmed in the quotation, including their applicable scope.</p>
    </div>
    <div class="project-review__rfq">
      <h3>Prepare your quote request</h3>
      <ul>
        <li>2D drawing and available 3D CAD, with matching revision.</li>
        <li>Material grade, quantity and expected repeat orders.</li>
        <li>Critical dimensions, datums, finish and inspection requirements.</li>
        <li>Target delivery date, destination and required documentation.</li>
      </ul>
      <a class="button" href="/cnc-machining-quote">Request a Quote</a>
    </div>
  </div>
  <p class="project-review__compare">{swiss ? "Reviewing a part with larger turned features and milling operations?" : "Reviewing a small, slender bar-stock part?"} <a href={swiss ? "/services/cnc-turning-and-milling" : "/services/swiss-machining"}>{swiss ? "Explore CNC turning and milling" : "Explore Swiss machining"} →</a></p>
</section>
<style>
  .project-review{max-width:var(--layout-shell);margin:0 auto;padding:64px 24px;color:var(--text);scroll-margin-top:90px}
  .project-review h2{margin:0 0 20px;color:var(--navy);font-size:var(--type-h2);line-height:1.2;text-align:center}
  .project-review__intro{max-width:880px;margin:0 auto 30px;text-align:center}
  .project-review__examples{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
  .project-review__examples article{border:1px solid var(--border);border-top:3px solid var(--color-brand);padding:24px;border-radius:8px;background:var(--color-white)}
  .project-review h3{font-size:20px;line-height:1.35;margin:0 0 14px;color:var(--navy)}
  .project-review h3 a,.project-review__compare a{color:var(--color-brand);text-decoration:underline;text-underline-offset:3px}
  .project-review p,.project-review dd,.project-review li{font-size:16px;line-height:1.7}
  .project-review__examples p{margin:0}
  .project-review .project-review__subheading{margin:38px 0 18px}
  .project-review__checks{margin:0;border:1px solid var(--border);border-radius:8px;overflow:hidden}
  .project-review__checks>div{display:grid;grid-template-columns:minmax(160px,1fr) 3fr;border-bottom:1px solid var(--border)}
  .project-review__checks>div:last-child{border:0}
  .project-review dt{padding:18px 20px;background:var(--muted);font-weight:600;color:var(--navy)}
  .project-review dd{margin:0;padding:18px 20px}
  .project-review__note{margin:16px 0 32px}
  .project-review__panels{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}
  .project-review__panels p{margin:0 0 16px}
  .project-review__rfq{padding:26px;background:var(--color-surface);border-radius:8px}
  .project-review__rfq ul{padding-left:20px;margin:0 0 22px}
  .project-review__rfq li{margin:8px 0}
  .project-review__compare{margin:28px 0 0}
  @media(max-width:767px){
    .project-review{padding:48px 24px}
    .project-review h2{font-size:var(--type-h2);text-align:left}
    .project-review__intro{text-align:left}
    .project-review__examples,.project-review__panels{grid-template-columns:1fr;gap:18px}
    .project-review__examples article,.project-review__rfq{padding:20px}
    .project-review__checks>div{grid-template-columns:1fr}
    .project-review dt{padding:12px 16px}
    .project-review dd{padding:14px 16px}
  }
</style>
