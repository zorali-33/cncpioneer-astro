---
const { sections = [] } = Astro.props;
---
{sections.length > 0 && <div class="material-drawing-guide" data-material-drawing-guide>
  {sections.map(section => <section class="section drawing-section" id={section.id}>
    <h2>{section.title}</h2>
    {section.paragraphs?.map(text => <p>{text}</p>)}
    {section.bullets && <ul>{section.bullets.map(text => <li>{text}</li>)}</ul>}
    {section.table && <div class="drawing-table" role="region" aria-label={section.title} tabindex="0">
      <table><thead><tr>{section.table.headers.map(text => <th scope="col">{text}</th>)}</tr></thead>
      <tbody>{section.table.rows.map(row => <tr>{row.map((text,index) => index === 0 ? <th scope="row">{text}</th> : <td>{text}</td>)}</tr>)}</tbody></table>
    </div>}
    {section.links && <ul class="drawing-links">{section.links.map(link => <li><a href={link.href}>{link.label} →</a></li>)}</ul>}
  </section>)}
</div>}
<style>
  .drawing-section { color:var(--color-ink); scroll-margin-top:24px; }
  .drawing-section h2 { color:var(--color-ink); font-size:var(--type-h2); line-height:1.2; }
  .drawing-section p,.drawing-section li { line-height:1.75; }
  .drawing-section li + li { margin-top:8px; }
  .drawing-table { max-width:100%; overflow-x:auto; margin:24px 0; border:1px solid var(--color-border); border-radius:6px; }
  table { width:100%; border-collapse:collapse; font-size:15px; line-height:1.6; }
  th,td { text-align:left; vertical-align:top; padding:16px; border-bottom:1px solid var(--color-border); }
  thead { background:var(--color-surface); } tbody th { width:30%; }
  .drawing-links { padding-left:20px; } a { color:var(--color-brand); text-underline-offset:3px; }
  a:focus-visible,.drawing-table:focus-visible { outline:3px solid var(--color-brand); outline-offset:3px; }
  @media(max-width:600px) { th,td { padding:12px; } tbody th { width:35%; } }
</style>

<style is:global>
  body:has([data-material-drawing-guide]) .material-service-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
  @media(max-width:900px) { body:has([data-material-drawing-guide]) .material-service-grid { grid-template-columns:minmax(0,1fr); } }
  @media(max-width:768px) { body:has([data-material-drawing-guide]) .faq-section--material { padding-inline:24px; } }
</style>
