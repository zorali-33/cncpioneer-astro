---
import {blogCategoryCounts} from '../../data/blogCategories.mjs';
const {articles,current='',topics=false,search=false}=Astro.props;
const categories=blogCategoryCounts(articles);
---
<div class="blog-explore">
  {search&&<form class="blog-explore-search" role="search" action="/search" method="get"><label for="blog-query">Find a machining guide</label><div><input type="hidden" name="type" value="resources"/><input id="blog-query" name="q" type="search" placeholder="Search processes, materials, parts…" maxlength="120" required/><button type="submit">Search <span aria-hidden="true">→</span></button></div></form>}
  <nav class="blog-category-nav" aria-label="Blog categories"><a href="/blog" aria-current={current===''?(Astro.url.pathname==='/blog'?'page':'location'):undefined}>All Articles <span>{articles.length}</span></a>{categories.map(category=><a href={category.href} aria-current={current===category.id?(Astro.url.pathname===category.href?'page':'location'):undefined}>{category.name}<span>{category.count}</span></a>)}</nav>
  {topics&&<section class="blog-topic-section" aria-labelledby="blog-topics-title"><h2 id="blog-topics-title">Explore a Topic</h2><div class="blog-topic-grid"><article><p class="blog-topic-kicker">MACHINE BUILDERS</p><h3>Automation Equipment</h3><p>Understand the machine, then plan which components to buy and which to machine.</p><a href="/blog/what-is-automation-equipment">Equipment types & components <span aria-hidden="true">→</span></a><a href="/blog/spm-machined-vs-bought-parts">SPM parts: machined vs bought <span aria-hidden="true">→</span></a></article><article><p class="blog-topic-kicker">MECHANISMS & ASSEMBLIES</p><h3>Robotics & Humanoid Robots</h3><p>Explore the hands, joints and mechanical components that connect a robot's systems.</p><a href="/blog/robot-hands">Robot hands engineering guide <span aria-hidden="true">→</span></a><a href="/blog/building-a-humanoid-robot">Building a humanoid robot <span aria-hidden="true">→</span></a></article></div></section>}
</div>
<style>
.blog-explore{width:min(var(--layout-shell),100%);padding:40px 24px 0;margin:auto}.blog-explore-search{max-width:640px;margin:0 auto 30px}.blog-explore-search label{display:block;margin-bottom:10px;color:var(--color-ink)}.blog-explore-search>div{display:flex;gap:10px}.blog-explore-search input[type=search]{flex:1;min-width:0;min-height:48px;padding:10px 14px;border:1px solid var(--color-border);border-radius:4px;background:var(--color-white);font-size:var(--type-body);color:var(--color-ink)}.blog-explore-search button{border:1px solid var(--color-brand);border-radius:4px;padding:10px 20px;background:var(--color-brand);color:var(--color-white);font-size:var(--type-body);cursor:pointer}.blog-explore-search button:hover{background:var(--color-hover)}.blog-category-nav{display:flex;flex-wrap:wrap;gap:10px}.blog-category-nav a{display:inline-flex;gap:12px;align-items:center;min-height:44px;padding:10px 14px;border:1px solid var(--color-border);border-radius:4px;text-decoration:none;color:var(--color-ink);background:var(--color-white);font-size:var(--type-small);line-height:1.4}.blog-category-nav a span{font-family:var(--font-mono);font-size:var(--type-label);color:var(--color-body)}.blog-category-nav a:hover{border-color:var(--color-brand);color:var(--color-brand)}.blog-category-nav a[aria-current]{color:var(--color-white);background:var(--color-brand);border-color:var(--color-brand)}.blog-category-nav a[aria-current] span{color:inherit}.blog-explore a:focus-visible,.blog-explore input:focus-visible,.blog-explore button:focus-visible{outline:2px solid var(--color-brand);outline-offset:3px}.blog-topic-section{margin-top:48px}.blog-topic-section>h2{font-size:var(--type-h2);font-weight:400;color:var(--color-ink);margin:0 0 26px}.blog-topic-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.blog-topic-grid article{padding:28px;border:1px solid var(--color-border);background:var(--color-surface);min-width:0}.blog-topic-kicker{font-family:var(--font-mono);font-size:var(--type-label);color:var(--color-brand);margin:0 0 14px}.blog-topic-grid h3{font-size:var(--type-h3);color:var(--color-ink);margin:0 0 12px}.blog-topic-grid article>p:not(.blog-topic-kicker){margin:0 0 18px}.blog-topic-grid a{display:block;width:fit-content;color:var(--color-brand);text-underline-offset:4px;margin-top:10px;line-height:1.5}@media(max-width:767px){.blog-explore{padding:28px 16px 0}.blog-category-nav{gap:8px}.blog-category-nav a{padding:10px 12px}.blog-topic-grid{grid-template-columns:1fr;gap:20px}.blog-topic-grid article{padding:22px}.blog-explore-search>div{gap:8px}.blog-explore-search button{padding-inline:14px}}
</style>
