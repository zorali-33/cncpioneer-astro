---
const {
  id,
  helpId,
  className = "",
} = Astro.props;
---

<div class:list={["quote-file-field", className]}>
  <label class="quote-file-field__label" for={id}>Drawing or CAD file <span>*</span></label>
  <div class="quote-file-picker">
    <input
      class="quote-file-picker__input"
      id={id}
      type="file"
      name="drawing"
      accept=".pdf,.step,.stp,.iges,.igs,.stl,.dxf,.dwg,.zip"
      aria-describedby={helpId}
      data-file-input
      required
    />
    <label class="quote-file-picker__control" for={id}>
      <span class="quote-file-picker__button">Choose file</span>
      <span class="quote-file-picker__name" data-file-name>No file selected</span>
    </label>
  </div>
  <p id={helpId} class="quote-file-field__help">
    Please provide your 2D drawings and 3D CAD models so we can quote more accurately. Combine multiple files into one ZIP.<br />
    PDF, STEP, STP, IGES, IGS, STL, DXF, DWG or ZIP · Maximum 50 MB
  </p>
</div>

<style>
  .quote-file-field{display:grid;gap:6px;min-width:0}
  .quote-file-field__label{display:block;margin:0;color:var(--color-ink);font-family:var(--font-sans);font-size:var(--type-small);font-weight:500;line-height:1.5}
  .quote-file-field__label span{color:var(--color-brand)}
  .quote-file-picker{position:relative;min-width:0}
  .quote-file-picker__input{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .quote-file-picker__control{box-sizing:border-box;display:grid;grid-template-columns:max-content minmax(0,1fr);align-items:stretch;width:100%;min-height:48px;margin:0;overflow:hidden;border:1px dashed var(--color-border);border-radius:3px;background:var(--color-white);color:var(--color-body);font-family:var(--font-sans);font-size:var(--type-small);line-height:1.4;cursor:pointer;transition:border-color .18s ease,background-color .18s ease}
  .quote-file-picker__button{display:inline-flex;align-items:center;justify-content:center;padding:9px 14px;border-right:1px solid var(--color-border);background:var(--color-surface);color:var(--color-brand);font-weight:500;white-space:nowrap}
  .quote-file-picker__name{display:block;align-self:center;min-width:0;padding:9px 12px;overflow:hidden;color:var(--color-body);font-weight:400;text-overflow:ellipsis;white-space:nowrap}
  .quote-file-picker__control:hover{border-color:var(--color-brand);background:var(--color-surface)}
  .quote-file-picker__input:focus-visible + .quote-file-picker__control{outline:2px solid var(--color-brand);outline-offset:2px;border-color:var(--color-brand)}
  .quote-file-field__help{margin:0;color:var(--color-body);font-family:var(--font-sans);font-size:var(--type-caption);font-weight:400;line-height:1.55}
  @media(max-width:360px){.quote-file-picker__button{padding-inline:10px}.quote-file-picker__name{padding-inline:9px}}
</style>
