---
import FileUploadField from './FileUploadField.astro';
const {idPrefix='compact-quote',formName='Quote Request',submitLabel='Send Quote Request'}=Astro.props;
---
<form class="compact-quote-form" action="/api/quote.php" method="post" enctype="multipart/form-data" name={formName} aria-label={formName} data-quote-form>
  <div class="compact-quote-form__honeypot" aria-hidden="true"><label for={`${idPrefix}-website`}>Leave this field empty</label><input id={`${idPrefix}-website`} name="company_website" type="text" tabindex="-1" autocomplete="off" /></div>
  <div class="compact-quote-form__row">
    <div><label for={`${idPrefix}-first-name`}>First name <span>*</span></label><input id={`${idPrefix}-first-name`} name="first_name" type="text" maxlength="80" autocomplete="given-name" required /></div>
    <div><label for={`${idPrefix}-last-name`}>Last name <span>*</span></label><input id={`${idPrefix}-last-name`} name="last_name" type="text" maxlength="80" autocomplete="family-name" required /></div>
  </div>
  <div class="compact-quote-form__row">
    <div><label for={`${idPrefix}-email`}>Work email <span>*</span></label><input id={`${idPrefix}-email`} name="email" type="email" maxlength="254" autocomplete="email" required /></div>
    <div><label for={`${idPrefix}-phone`}>Phone number <span>(optional)</span></label><input id={`${idPrefix}-phone`} name="phone" type="tel" maxlength="40" autocomplete="tel" /></div>
  </div>
  <div><label for={`${idPrefix}-country`}>Country / region <span>(optional)</span></label><input id={`${idPrefix}-country`} name="country" type="text" maxlength="160" autocomplete="country-name" /></div>
  <div><label for={`${idPrefix}-message`}>Project requirements <span>*</span></label><textarea id={`${idPrefix}-message`} name="message" maxlength="12000" rows="3" placeholder="Material, quantity, finish, critical dimensions and target date" required></textarea></div>
  <FileUploadField id={`${idPrefix}-file`} helpId={`${idPrefix}-file-help`} />
  <button type="submit"><span data-submit-label>{submitLabel}</span><span aria-hidden="true">→</span></button>
  <p class="compact-quote-form__status" data-quote-status role="status" aria-live="polite" tabindex="-1"></p>
</form>
<script>import '../../scripts/quote-form.js';</script>
<style>
  .compact-quote-form{display:grid;gap:13px;width:100%;max-width:560px;justify-self:end;padding:26px;background:var(--color-white);border:1px solid var(--color-border);color:var(--color-ink);box-sizing:border-box}
  .compact-quote-form__honeypot{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
  .compact-quote-form__row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .compact-quote-form>div:not(.compact-quote-form__honeypot),.compact-quote-form__row>div{min-width:0}
  .compact-quote-form label{display:block;margin-bottom:5px;font-family:var(--font-sans);font-size:var(--type-caption);font-weight:500;color:var(--color-ink);line-height:1.5}
  .compact-quote-form label span{color:var(--color-brand)}
  .compact-quote-form input:not([type="file"]),.compact-quote-form textarea{box-sizing:border-box;display:block;width:100%;min-height:40px;padding:8px 10px;border:1px solid var(--color-border);border-radius:2px;background:var(--color-white);color:var(--color-ink);font-family:var(--font-sans);font-size:var(--type-body)}
  .compact-quote-form textarea{min-height:84px;resize:vertical}
  .compact-quote-form input:focus-visible,.compact-quote-form textarea:focus-visible{outline:2px solid var(--color-brand);outline-offset:1px;border-color:var(--color-brand)}
  .compact-quote-form button{display:inline-flex;align-items:center;justify-content:center;gap:24px;justify-self:start;min-height:42px;padding:10px 18px;border:1px solid var(--color-brand);border-radius:2px;background:var(--color-brand);color:var(--color-white);font-family:var(--font-sans);font-size:var(--type-small);font-weight:500;cursor:pointer}
  .compact-quote-form button:hover{background:var(--color-hover)}
  .compact-quote-form button:focus-visible{outline:2px solid var(--color-brand);outline-offset:3px}
  .compact-quote-form button:disabled{opacity:.65;cursor:wait}
  .compact-quote-form__status{margin:0;color:var(--color-ink);font-size:var(--type-small);line-height:1.5}
  .compact-quote-form__status:empty{display:none}
  .compact-quote-form__status[data-state="success"]{color:var(--color-brand)}
  @media(max-width:800px){.compact-quote-form{justify-self:start}}
  @media(max-width:480px){.compact-quote-form{padding:20px 16px}.compact-quote-form__row{grid-template-columns:1fr;gap:13px}}
</style>
