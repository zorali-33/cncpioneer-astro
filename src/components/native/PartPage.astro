      { title: "Automotive", text: applications?.text || page.description, image: "/wp-content/uploads/2026/09/automotive.jpg" },
      { title: "Semiconductor", text: applications?.text || page.description, image: "/wp-content/uploads/2026/09/semiconductor.jpg" },
      { title: "Aerospace", text: applications?.text || page.description, image: "/wp-content/uploads/2026/09/aerospace.jpg" },
    ]
  : isStainlessFlanges
    ? flangeApplicationCards
  : gallery.slice(4, 7).map((item) => ({ title: item.name.split(" ").slice(0, 3).join(" "), text: applications?.text || item.alt || item.name, image: item.image }));
const materialLabels = isSpringLoaded ? [
  "Brass and copper alloys",
  "Beryllium copper and bronze",
  "stainless steel",
] : [
  "Brass and copper alloys",
  "Beryllium copper and bronze",
  "stainless steel",
  "Specified conductive alloys",
  "Customer supplied material",
  "Clean packaged components",
];
const materialCards = isStainlessFlanges ? flangeMaterialCards : materialLabels.map((title) => ({ title, text: materials?.text || page.description }));
const treatmentCards = isStainlessFlanges ? flangeTreatmentCards : [
  "Gold Plating",
  "Nickel Barrier",
  "Tin Plating",
  "Silver Plating",
  "Low-Burr Finishing",
  "Clean Packaging",
].map((title) => ({ title, text: treatments?.text || page.description }));
const qualityCards = isStainlessFlanges
  ? flangeQualityCards
  : (quality?.items?.length ? quality.items.slice(0, 4) : [
    "Material, tooling, and fixture control",
    "In-process and final inspection",
    "Critical feature documentation",
    "Certificates and batch traceability",
  ]).map(splitItem);
const flangeLiveOverviewParagraphs = [
  "Precision stainless steel CNC turning flanges connect pipe, vessel, vacuum, sanitary and exhaust interfaces where sealing face quality, bore alignment and bolt-circle accuracy matter.",
  "CNCPioneer machines 304, 316L and 316Ti flanges with mill-turn datum control, CMM inspection, material verification and passivation or pressure-test documentation when required.",
];
const flangeLiveOverviewItems = [
  {
    title: "MAZAK mill-turn single-setup geometric coherence",
    text: "Face, bore and bolt circle are machined from one datum to control flatness, concentricity and true position.",
  },
  {
    title: "Stainless work-hardening management in flange facing",
    text: "Feed, insert geometry and coolant are controlled to avoid hardened sealing faces and unstable Ra.",
  },
  {
    title: "Complete flange standard compliance from one source",
    text: "ANSI/ASME, DIN, JIS, ASME BPE, ConFlat/KF/ISO and exhaust OEM flange programs are supported.",
  },
  {
    title: "Material, standard and sealing-face verification",
    text: "Available records include XRF checks, CMM reports, face profiling, thread gauges and passivation data.",
  },
];
const overviewParagraphs = isStainlessFlanges ? flangeLiveOverviewParagraphs : [overview?.text || page.description];
const overviewItems = isStainlessFlanges ? flangeLiveOverviewItems : (overview?.items?.length ? overview.items.slice(0, 4).map(splitItem) : []);
const visualTitleLead = pageVisual?.titleLead || titleLead;
const visualTitleAccent = pageVisual?.titleAccent || titleAccent;
const visualHeroImage = pageVisual?.heroImage || heroImage;
const visualOverviewImage = pageVisual?.overviewImage || overviewImage;
const visualStats = pageVisual?.stats || [
  ["78+", "Swiss CNC"],
  ["66+", "MAZAK Centres"],
  ["+/-0.005mm", "Capability"],
  ["100%", "Inspection"],
];
const displayFaqs = isStainlessFlanges ? flangeFaqs : page.faqs;
---
<BaseLayout seo={page.seo}>
  <div class:list={["native-product", isStainlessFlanges && "product-detail-template"]}>
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-content">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/custom-cnc-parts">Custom CNC Parts</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{isStainlessFlanges ? "Stainless Steel CNC Turning Flanges" : page.title}</span>
        </nav>
        {!isStainlessFlanges && <div class="hero-eyebrow">{pageVisual?.eyebrow || `${page.categoryLabel} · China Factory · IATF 16949 · AS9100D`}</div>}
        <h1>{visualTitleLead}{visualTitleAccent && <><br /><span>{visualTitleAccent}</span></>}</h1>
        <p class="hero-sub">{pageVisual?.description || page.description}</p>
        <div class="hero-ctas">
          <a class="btn-primary" href="/cnc-machining-quote">{isStainlessFlanges ? "↑ Upload Drawing" : "Upload Drawing"}</a>
          <a class="btn-secondary" href="/cnc-machining-quote">{isStainlessFlanges ? "Request a Quote →" : "Request a Quote"}</a>
        </div>
        <div class="hero-trust">
          {(pageVisual?.trust || [
            "IATF 16949:2016 & AS9100D & ISO 10012:2003",
            "78+ Swiss CNC · 66+ MAZAK Mill-Turn Centres",
            "Plunger / Barrel Diameter to +/-0.005mm",
            "100% Critical-Feature Inspection",
          ]).map((item) => <div class="trust-item">{item}</div>)}
        </div>
      </div>
      <div class="hero-image-wrap">
        <img class="hero-img" src={visualHeroImage} alt={page.title} loading="eager" fetchpriority="high" />
        <div class="hero-img-badge">
          <div class="hero-img-badge-row"><span class="badge-val">{pageVisual?.heroBadge?.[0]?.[0] || "+/-0.005mm"}</span><span class="badge-label">{pageVisual?.heroBadge?.[0]?.[1] || "Plunger / Barrel Diameter"}</span></div>
          <div class="hero-img-badge-divider"></div>
          <div class="hero-img-badge-row"><span class="badge-val">{pageVisual?.heroBadge?.[1]?.[0] || "100%"}</span><span class="badge-label">{pageVisual?.heroBadge?.[1]?.[1] || "Critical Test-Pin Inspection"}</span></div>
        </div>
      </div>
      </div>
    </section>

    <section class="section-overview">
      <div class="container">
        <div class="overview-grid-b">
          <div class="overview-text-col">
            <h2 class="section-title">{isStainlessFlanges ? <Fragment>What Are Precision Stainless Steel<br />CNC Turning Flanges?</Fragment> : (overview?.heading || `What Are ${page.title}?`)}</h2>
            <div class="overview-body">
              {overviewParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            {overviewItems.length > 0 && (
              <ul class="op-list">
                {overviewItems.map((item) => <li><div class="op-list-icon">+</div><div><strong>{item.title}</strong><span>{item.text}</span></div></li>)}
              </ul>
            )}
          </div>
          <div class="overview-photo-col">
            <div class="overview-photo-main">
              <img src={visualOverviewImage} alt={overview?.heading || page.title} loading="lazy" />
              <div class="overview-chip overview-chip-tl"><div class="chip-val">{isStainlessFlanges ? "66+ MAZAK" : "6+"}</div><div class="chip-label">{isStainlessFlanges ? "Mill-Turn Centers" : "Materials"}</div></div>
              <div class="overview-chip overview-chip-br"><div class="chip-val">{isStainlessFlanges ? "99%" : "+/-0.005mm"}</div><div class="chip-label">{isStainlessFlanges ? "Qualification Rate" : "Diameter"}</div></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-dark">
      <div class="container">
        <div class="text-center">
          <h2 class="section-title">{isStainlessFlanges ? <Fragment>Why CNCPioneer for CNC Turning<br />Stainless Steel Flanges?</Fragment> : (why?.heading || `Why CNCPioneer for ${page.title}?`)}</h2>
          <p class="section-intro">
            {isStainlessFlanges ? "Single-setup mill-turn accuracy, stainless surface control and documented inspection for process, automotive, sanitary and vacuum flange programs." : (why?.text || page.description)}
          </p>
        </div>
        <div class="why-cards">
          {whyCards.map((card, index) => (
            <article class="why-card">
              <div class="why-card-num">{String(index + 1).padStart(2, "0")}</div>
              <div class="why-card-body">
                <h3>{card.title}</h3>
                <p>{card.text}</p>
              </div>
            </article>
          ))}
        </div>
        {!isStainlessFlanges && (
          <div class="why-compare-bar">
            <span>Quality System</span>
            <span>Material Control</span>
            <span>Force Testing</span>
            <span>Clean Packaging</span>
            <span>Fast Quote</span>
          </div>
        )}
      </div>
    </section>

    {portfolioCards.length > 0 && (
      <section class="section-light">
        <div class="container">
          <div class="text-center">
            <h2 class="section-title">{isStainlessFlanges ? <Fragment>Stainless Steel CNC Turning Flanges<br />We Manufacture</Fragment> : (portfolio?.heading || `${page.title} Product Portfolio`)}</h2>
            <p class="section-intro">{portfolio?.text || page.description}</p>
          </div>
          <div class:list={["portfolio-grid", isStainlessFlanges && "parts-grid"]}>
            {portfolioCards.map((card) => (
              <article class="portfolio-card">
                <img src={card.image} alt={card.title} loading="lazy" />
                <h3>{card.title}</h3>
                <p>{isStainlessFlanges ? (flangePortfolioSummaries.get(card.title) || card.text) : card.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {applicationCards.length > 0 && (
      <section class="section-white" id={isStainlessFlanges ? "industries-applications" : undefined}>
        <div class="container">
          <div class="text-center">
            <h2 class="section-title">{applications?.heading || "Industries & Applications"}</h2>
            <p class="section-intro">{applications?.text || page.description}</p>
          </div>
          <div class:list={["application-grid", isStainlessFlanges && "industries-grid"]}>
            {applicationCards.map((card) => (
              <article class:list={["application-card", card.href && "has-industry-link"]}>
                <img src={card.image} alt={card.title} loading="lazy" />
                <h3>{card.title}</h3>
                <p>{card.text}</p>
                {card.href && <a class="industry-link" href={card.href}>Explore {card.title.toLowerCase()} machining<span aria-hidden="true"> →</span></a>}
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section-light" id={isStainlessFlanges ? "product-materials" : undefined}>
      <div class="container">
        <div class="text-center">
          <p class="section-kicker">Materials</p>
          <h2 class="section-title">{materials?.heading || `Materials for ${page.title}`}</h2>
          <p class="section-intro">{materials?.text || page.description}</p>
        </div>
        <div class:list={["material-grid", isStainlessFlanges && "mat-cards"]}>
          {materialCards.map((card) => (
            <article class="material-card" data-category={card.category}>
              {isStainlessFlanges && <div class="mat-swatch"></div>}
              {card.tag && <div class="mat-card-tag">{card.tag}</div>}
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
        {isStainlessFlanges && <nav class="flange-material-links" aria-labelledby="flange-material-links-title">
          <div>
            <h3 id="flange-material-links-title">Explore Stainless Steel Machining</h3>
            <p>Review stainless grades, machinability and finishing options before confirming your flange material.</p>
          </div>
          <a href="/materials/stainless-steel-cnc-machining"><span>Stainless Steel CNC Machining</span><span aria-hidden="true">→</span></a>
        </nav>}
      </div>
      </section>

    {isStainlessFlanges ? <FlangeSurfaceTreatments /> : (
    <section class="finish-dark">
      <div class="container">
        <div class="text-center">
          <h2 class="section-title">{treatments?.heading || `Surface Treatments for ${page.title}`}</h2>
          <p class="section-intro">{treatments?.text || page.description}</p>
        </div>
        <div class:list={["surface-grid", isStainlessFlanges && "finish-cards"]}>
          {treatmentCards.map((card) => (
            <article class:list={["surface-card", isStainlessFlanges && "fin-card"]}>
              <div class={isStainlessFlanges ? "fin-card-visual" : "surface-pill"}></div>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    )}

    {isStainlessFlanges ? <FlangeQualityControl stats={visualStats} /> : (
    <section class="section-light">
      <div class="container">
        <div class="text-center">
          <h2 class="section-title">{quality?.heading || `Quality System for ${page.title}`}</h2>
          <p class="section-intro">{quality?.text || page.description}</p>
        </div>
        <div class:list={["quality-grid", isStainlessFlanges && "quality-steps"]}>
          {qualityCards.map((card) => (
            <article class:list={["quality-card", isStainlessFlanges && "quality-step"]}>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
        <div class:list={["stats-strip", isStainlessFlanges && "stats-bar"]}>
          {visualStats.map(([value, label]) => <div><strong>{value}</strong><span>{label}</span></div>)}
        </div>
      </div>
    </section>
    )}

    {isStainlessFlanges ? <FlangeFaq items={displayFaqs} /> : displayFaqs.length > 0 && (
      <section class="section-faq">
        <div class="container">
          <h2 class="section-title text-center">{isStainlessFlanges ? "CNC Turning Stainless Steel Flanges FAQ" : `${page.title} FAQ`}</h2>
          <div class="faq-accordion" data-faq-accordion>
            {displayFaqs.map((item, index) => (
              <div class="faq-row">
                <button class="faq-question" id={`faq-question-${page.slug}-${index}`} type="button" aria-controls={`faq-answer-${page.slug}-${index}`} aria-expanded={index === 0 ? "true" : "false"}>
                  <span>{item.question}</span>
                  <span class="faq-chevron" aria-hidden="true">⌄</span>
                </button>
                <div id={`faq-answer-${page.slug}-${index}`} role="region" aria-labelledby={`faq-question-${page.slug}-${index}`} class:list={["faq-answer", index === 0 && "open"]}><p>{item.answer}</p></div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {!isSpringLoaded && related.length > 0 && (
      <section class="section-related" id="related-custom-cnc-parts">
        <div class="container">
        <h2 class="section-title text-center">Related Custom CNC Parts</h2>
        <div class="related-grid">
          {related.map((item) => (
            <a class="related-card" href={`/custom-cnc-parts/${item.slug}`}>
              <img src={item.image} alt={item.title} loading="lazy" />
              <strong>{item.title}</strong>
            </a>
          ))}
        </div>
        </div>
      </section>
    )}

    <QuoteCta id={`part-${page.slug}-quote`} idPrefix={`part-${page.slug}-quote-form`} formName={`${page.title} Part Quote`} kicker="CUSTOM CNC PARTS" title={`Get a quote for ${isStainlessFlanges ? "CNC Turning Stainless Steel Flanges" : page.title}`} description={isStainlessFlanges ? "Share the flange drawing, 3D model, standard, material grade and gasket-face requirements for a quote and DFM review." : "Upload a drawing or 3D model. We’ll review geometry, material, finishing, lead time and inspection requirements."} />
  </div>
  <script>
      (() => {
        const root = document.querySelector(".native-product");
        if (!root) return;

        const tabs = Array.from(root.querySelectorAll("[data-mat-tabs] .mat-tab"));
        const cards = Array.from(root.querySelectorAll(".mat-cards .material-card"));
        for (const tab of tabs) {
          tab.addEventListener("click", () => {
            const filter = tab.getAttribute("data-filter") || "all";
            for (const item of tabs) {
              const active = item === tab;
              item.classList.toggle("active", active);
              item.setAttribute("aria-pressed", String(active));
            }
            for (const card of cards) {
              const show = filter === "all" || card.getAttribute("data-category") === filter;
              card.hidden = !show;
            }
          });
        }

        const faqRows = Array.from(root.querySelectorAll("[data-faq-accordion] .faq-row"));
        for (const row of faqRows) {
          const button = row.querySelector(".faq-question");
          const answer = row.querySelector(".faq-answer");
          button?.addEventListener("click", () => {
            const shouldOpen = !answer?.classList.contains("open");
            for (const item of faqRows) {
              item.querySelector(".faq-answer")?.classList.remove("open");
              item.querySelector(".faq-question")?.setAttribute("aria-expanded", "false");
            }
            if (shouldOpen) {
              answer?.classList.add("open");
              button.setAttribute("aria-expanded", "true");
            }
          });
        }
      })();
  </script>
  <style>
    .flange-material-links { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 24px; margin-top: 28px; padding: 24px; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-white); }
    .flange-material-links h3 { margin: 0 0 8px; color: var(--color-ink); font-size: 20px; line-height: 1.4; }
    .flange-material-links p { max-width: 620px; margin: 0; color: var(--color-body); font-size: 15px; line-height: 1.65; }
    .flange-material-links a { display: inline-flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 12px 16px; border: 1px solid var(--color-border); border-radius: 5px; color: var(--color-brand); font-size: 14px; font-weight: 600; line-height: 1.5; text-decoration: none; }
    .flange-material-links a > span:last-child { flex-shrink: 0; }
    .flange-material-links a:hover { border-color: var(--color-hover); background: var(--color-surface); }
    .flange-material-links a:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 3px; }
    @media (max-width: 768px) {
      .flange-material-links { grid-template-columns: minmax(0, 1fr); gap: 18px; padding: 20px; }
    }
  </style>
</BaseLayout>
