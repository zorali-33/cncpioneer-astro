---
import SiteHeaderSpacer from "./SiteHeaderSpacer.astro";
import IndustryNavigation from './IndustryNavigation.astro';
import NavigationMaterialGroup from './NavigationMaterialGroup.astro';
import {getSiteNavigation} from '../../data/siteNavigation.mjs';
import SiteSearch from "./SiteSearch.astro";
import QuoteCta from "./QuoteCta.astro";
import { getBlogAuthor } from '../../blog-detail-native.mjs';
import { createArticleSchema, jsonLd } from '../../data/articleSchema.mjs';
import { getPageModifiedTime } from '../../data/pageDates.mjs';

const {
  article,
  relatedPosts,
} = Astro.props;
const author = getBlogAuthor(article.authorSlug);
const contributors = (article.contributors || []).map(getBlogAuthor);
const authorBio = Astro.props.authorBio || author.bio;
const hasToc = article.tocItems.length > 0;
const modifiedTime = getPageModifiedTime(article.canonical, article.modifiedTime, article.publishedTime);
const updatedDate = modifiedTime?.split('T')[0] || article.publishedDate;
const articleSchema = createArticleSchema(article, author, contributors);

const navItems = getSiteNavigation(Astro.url.pathname);

const footerColumns = [
  {
    heading: 'Services',
    links: [
      { label: 'Swiss Machining Service', href: '/services/swiss-machining' },
      { label: 'CNC Turning and Milling  Service', href: '/services/cnc-turning-and-milling' }
    ]
  },
  {
    heading: 'Industries',
    links: [
      { label: 'Aerospace', href: '/industries/aerospace' },
      { label: 'Defense', href: '/industries/defense' },
      { label: 'Medical', href: '/industries/medical' },
      { label: 'Semiconductor', href: '/industries/semiconductor' },
      { label: 'Consumer Electronics', href: '/industries/consumer-electronics' },
      { label: 'Oil & Gas', href: '/industries/oil-gas' },
      { label: 'Automotive', href: '/industries/automotive' },
      { label: 'Railway', href: '/industries/railway' }
    ]
  },
  {
    heading: 'About',
    links: [
      { label: 'About Us', href: '/about-us' },
      { label: 'Blog', href: '/blog' }
    ]
  }
];

const shareUrl = encodeURIComponent(article.canonical);
const shareTitle = encodeURIComponent(article.articleTitle);
const shareImage = article.image
  ? encodeURIComponent(article.image.startsWith('http') ? article.image : `https://www.cncpioneer.com${article.image}`)
  : '';
const shareLinks = [
  {
    label: 'Share on Facebook',
    className: 'facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`,
    viewBox: '0 0 320 512',
    path: 'M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06H297V6.26S260.43 0 225.36 0C152.14 0 104.1 44.38 104.1 124.72v70.62H22.89V288h81.21v224h100.35V288z',
  },
  {
    label: 'Share on X',
    className: 'x',
    href: `https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`,
    viewBox: '0 0 512 512',
    path: 'M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8l164.9-188.5L26.8 48h145.6l100.6 132.9L389.2 48zm-24.8 373.8h39.1L151.1 88h-42z',
  },
  {
    label: 'Share on Pinterest',
    className: 'pinterest',
    href: `https://pinterest.com/pin/create/button/?url=${shareUrl}&description=${shareTitle}${shareImage ? `&media=${shareImage}` : ''}`,
    viewBox: '0 0 496 512',
    path: 'M496 256c0 137-111 248-248 248-25.6 0-50.2-3.9-73.4-11.1 10.1-16.5 25.2-43.5 30.8-65 3-11.6 15.4-58.9 15.4-58.9 8.1 15.4 31.7 28.5 56.8 28.5 74.8 0 128.7-68.8 128.7-154.3 0-81.9-66.9-143.2-152.9-143.2-107.1 0-163.9 71.8-163.9 150.1 0 36.4 19.4 81.7 50.4 96.1 4.7 2.2 7.2 1.2 8.3-3.3.8-3.4 5-20.3 6.9-28.1.6-2.5.3-4.7-1.7-7.1-10.2-12.4-18.4-35.2-18.4-56.4 0-54.7 41.4-107.7 112-107.7 60.9 0 103.5 41.5 103.5 100.8 0 67-33.8 113.5-77.7 113.5-24.3 0-42.5-20.1-36.7-44.8 7-29.5 20.5-61.3 20.5-82.6 0-19-10.2-34.9-31.4-34.9-24.9 0-44.9 25.7-44.9 60.2 0 22 7.4 36.8 7.4 36.8s-24.6 104.1-29.1 123.5c-5 21.4-3 51.4-.9 70.8C62.5 469.5 0 371.7 0 256 0 119 111 8 248 8s248 111 248 248z',
  },
  {
    label: 'Share on Reddit',
    className: 'reddit',
    href: `https://www.reddit.com/submit?url=${shareUrl}&title=${shareTitle}`,
    viewBox: '0 0 512 512',
    path: 'M440.3 203.5c-15 0-28.2 6.2-37.9 15.9-35.7-24.7-83.8-40.6-137.1-42.3l28.2-132 92.2 19.6c1.1 23.4 20.4 42.1 44.1 42.1 24.4 0 44.2-19.8 44.2-44.2S454.2 18.4 429.8 18.4c-17.4 0-32.4 10.1-39.6 24.7L286.1 20.9c-5.5-1.2-10.9 2.4-12.1 7.9L242.6 177c-54.7 1-104.2 17-140.6 42.5-9.7-9.8-23.1-16-38.1-16-39.6 0-59.5 48.1-31.5 76.1-1.1 5-1.7 10.2-1.7 15.4 0 65.7 75 119 167.5 119s167.5-53.3 167.5-119c0-5.2-.6-10.3-1.7-15.4 28-28 8.1-76.1-23.7-76.1zM129.2 279.9c0-17.7 14.4-32.1 32.1-32.1s32.1 14.4 32.1 32.1-14.4 32.1-32.1 32.1-32.1-14.4-32.1-32.1zm178.3 78.1c-29.9 29.9-78.5 29.9-108.4 0-4-4-4-10.5 0-14.5s10.5-4 14.5 0c21.9 21.9 57.5 21.9 79.4 0 4-4 10.5-4 14.5 0s4 10.5 0 14.5zm-5.5-46c-17.7 0-32.1-14.4-32.1-32.1s14.4-32.1 32.1-32.1 32.1 14.4 32.1 32.1-14.4 32.1-32.1 32.1z',
  },
];
---

<!doctype html>
<html lang="en-US" class="blog-detail-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="profile" href="https://gmpg.org/xfn/11" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <title>{article.title}</title>
    {article.description && <meta name="description" content={article.description} />}
    <link rel="canonical" href={article.canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={article.title} />
    {article.ogDescription && <meta property="og:description" content={article.ogDescription} />}
    <meta property="og:url" content={article.canonical} />
    <meta property="og:site_name" content="CNCPioneer" />
    {article.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <script type="application/ld+json" set:html={jsonLd(articleSchema)} />
    {article.image && <meta property="og:image" content={article.image.startsWith('http') ? article.image : `https://www.cncpioneer.com${article.image}`} />}
    {article.imageWidth && <meta property="og:image:width" content={article.imageWidth} />}
    {article.imageHeight && <meta property="og:image:height" content={article.imageHeight} />}
    {article.imageType && <meta property="og:image:type" content={article.imageType} />}
    <meta name="author" content={author.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:label1" content="Written by" />
    <meta name="twitter:data1" content={author.name} />
    {article.readingTime && <meta name="twitter:label2" content="Est. reading time" />}
    {article.readingTime && <meta name="twitter:data2" content={article.readingTime} />}
    <link rel="icon" href="/wp-content/uploads/2026/01/cropped-site-icon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/wp-content/uploads/2026/01/cropped-site-icon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2026/01/cropped-site-icon-180x180.png" />
    <meta name="msapplication-TileImage" content="/wp-content/uploads/2026/01/cropped-site-icon-270x270.png" />
  </head>
  <body class:list={['blog-detail-page', article.bodyClass]}>
    <header class="site-header">
      <div class="topbar">
        <div class="topbar-inner">
          <div class="topbar-contact" aria-label="Contact details">
            <span class="topbar-item">
              <svg viewBox="0 0 512 512" aria-hidden="true"><path d="M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.7-98.9 140.5-177.2 177.2l-49.6-60.6c-6.8-8.3-18.2-11.1-28-6.9l-112 48C3.9 366.5-2 378.1.6 389.4l24 104C27.1 504.2 36.7 512 48 512c256.1 0 464-207.5 464-464 0-11.2-7.7-20.9-18.6-23.4z"></path></svg>
              +8613725562746
            </span>
            <span class="topbar-item">
              <svg viewBox="0 0 512 512" aria-hidden="true"><path d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z"></path></svg>
              info@cncpioneer.com
            </span>
          </div>
          <div class="topbar-actions">
            <button class="icon-button" aria-label="Search">
              <svg viewBox="0 0 512 512" aria-hidden="true"><path d="M505 442.7 405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128 0-70.7 57.2-128 128-128 70.7 0 128 57.2 128 128 0 70.7-57.2 128-128 128z"></path></svg>
            </button>
          </div>
        </div>
      </div>
      <div class="mainnav">
        <div class="nav-inner">
          <a class="brand" href="/" aria-label="CNC Pioneer home">
            <img src="/wp-content/uploads/2025/11/cncpioneer_nav_logo.png" alt="CNC Pioneer" width="160" height="35" />
          </a>
          <input class="menu-state" type="checkbox" id="menu-state" aria-hidden="true" />
          <label class="menu-toggle" for="menu-state" aria-label="Menu Toggle">
            <span></span>
            <span></span>
            <span></span>
          </label>
          <nav class="primary-nav" aria-label="Menu">
            <ul>
              {navItems.map((item) => (
                <li class:list={[item.children && 'has-submenu']}>
                  {item.href ? <a href={item.href} aria-current={item.active ? (Astro.url.pathname === item.href ? 'page' : 'location') : undefined}>
                    {item.label}{item.children && <span class="caret" aria-hidden="true"></span>}
                  </a> : <button class="nav-label-button" data-dropdown-trigger type="button" aria-expanded="false" aria-controls={item.id + '-submenu'}>{item.label}<span class="caret" aria-hidden="true"></span></button>}
                  {item.children && (
                    <ul class="submenu" id={(item.id || item.href.slice(1)) + "-submenu"}>
                      {item.href === '/industries' ? <li class="industry-menu-content"><IndustryNavigation /></li> : item.children.map((child) => (
                        <li>{child.children ? <NavigationMaterialGroup group={child} /> : <a href={child.href}>{child.label}</a>}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </header>
    <SiteHeaderSpacer />

    <main id="content" class="detail-main">
      <nav class="detail-breadcrumb-bar" aria-label="Breadcrumb">
        <div class="detail-breadcrumb-inner">
          <p id="breadcrumbs" class="detail-breadcrumbs"><span><a href="/">Home</a></span> <span aria-hidden="true">&raquo;</span> <span><a href="/blog">Blog</a></span> <span aria-hidden="true">&raquo;</span> <span aria-current="page">{article.articleTitle}</span></p>
        </div>
      </nav>

      <section class="detail-title-hero" aria-labelledby="article-title">
        <div class="detail-title-inner">
          <h1 id="article-title">{article.articleTitle}</h1>
          <ul class="post-meta" aria-label="Post information">
            <li><span>Written by</span> {author.name}</li>
            {updatedDate && <li><span>Last updated on</span> <time datetime={updatedDate}>{updatedDate}</time></li>}
            {article.readingTime && <li><span>Reading time</span> <span>{article.readingTime}</span></li>}
          </ul>
        </div>
      </section>

      <section class:list={['detail-shell', { 'detail-shell--no-toc': !hasToc }]}>
        <article class="detail-article-column" aria-labelledby="article-title">
          {contributors.length > 0 && <p class="detail-contributors">Contributing material: {contributors.map((person, index) => <>{index > 0 && ', '}<a href={person.href}>{person.name}</a></>)}</p>}
          <div id="main-article-content" class="article-content" set:html={article.articleHtml}></div>
          <aside class="article-inline-cta article-template-cta" aria-label="CNC machining quote">
            <div class="article-inline-cta__copy">
              <p class="article-inline-cta__eyebrow">CNC machining RFQ</p>
              <p class="article-inline-cta__title">Need reliable CNC machined parts for your next project?</p>
              <p class="article-inline-cta__text">Send your drawings, material, tolerance and quantity requirements. Our engineering team can review the project and provide DFM feedback before production.</p>
            </div>
            <a class="article-inline-cta__button" href="/cnc-machining-quote" aria-label="Get an instant CNC machining quote">Get Instant Quote</a>
          </aside>
          <section class="article-share" aria-label="Share this article">
            <h2 class="article-share__label">Share:</h2>
            <div class="article-share__links">
              {shareLinks.map((link) => (
                <a class:list={['article-share__link', `article-share__link--${link.className}`]} href={link.href} aria-label={link.label} target="_blank" rel="noopener noreferrer nofollow">
                  <svg viewBox={link.viewBox} aria-hidden="true" focusable="false">
                    <path d={link.path}></path>
                  </svg>
                </a>
              ))}
            </div>
          </section>
          <section class="detail-author-box" aria-labelledby="detail-author-name">
            <a class="detail-author-avatar" href={author.href}>
              <img src={author.image} width="100" height="100" alt={`Picture of ${author.name}`} loading="lazy" />
            </a>
            <div class="detail-author-text">
              <h3 id="detail-author-name" class="detail-author-name"><a href={author.href}>{author.name}</a></h3>
              <div class="detail-author-bio">
                <p>{authorBio}</p>
              </div>
            </div>
          </section>
        </article>

        {hasToc && <aside class="detail-toc-rail" aria-label="Table of contents">
          <nav class="toc-box" aria-labelledby="toc-heading" data-toc>
            <button class="toc-header" type="button" aria-expanded="true" aria-controls="toc-list-panel" data-toc-toggle>
              <span id="toc-heading" class="toc-heading">Table of Contents</span>
              <svg class="toc-toggle" viewBox="0 0 448 512" aria-hidden="true"><path d="M207.029 381.476 12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z"></path></svg>
            </button>
            <div id="toc-list-panel" class="toc-body" data-toc-body>
              <div class="toc-body-inner">
                <ol class="toc-list">
                  {article.tocItems.map((item) => (
                    <li><a href={`#${item.id}`}>{item.text}</a></li>
                  ))}
                </ol>
              </div>
            </div>
          </nav>
        </aside>}
      </section>

      <section class="related-posts" aria-labelledby="related-title">
        <h2 id="related-title">Related Posts</h2>
        <div class="related-grid" role="list">
          {relatedPosts.map((post) => (
            <article class="related-card" role="listitem">
              <a class="related-card-thumb" href={post.href} tabindex="-1">
                <img src={post.image} alt={post.alt} loading="lazy" decoding="async" />
              </a>
              <div class="related-card-text">
                <h3><a href={post.href}>{post.title}</a></h3>
                <a class="related-read-more" href={post.href} aria-label={`Read more about ${post.title}`} tabindex="-1">Read More</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <QuoteCta id={`article-${article.slug}-quote`} idPrefix={`article-${article.slug}-quote-form`} formName="Article Project Enquiry" kicker="FROM READING TO PRODUCTION" title="Discuss your next CNC project" description="Send your drawing, material, quantity and inspection needs. We’ll review the machining requirements for your part." />
    </main>

    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-inner">
          {footerColumns.map((column) => (
            <section class="footer-column" aria-labelledby={`footer-${column.heading.trim().toLowerCase().replace(/\s+/g, '-') || 'about'}`}>
              <h2 id={`footer-${column.heading.trim().toLowerCase().replace(/\s+/g, '-') || 'about'}`}>{column.heading}</h2>
              <ul>
                {column.links.map((link) => (
                  <li><a href={link.href}>{link.label}</a></li>
                ))}
              </ul>
            </section>
          ))}
          <section class="footer-column contact-column" aria-labelledby="footer-contact">
            <h2 id="footer-contact">Get In Touch</h2>
            <p>Room 1202B54, 12th Floor, Tairan Cangsong Building, No. 25,<br />Futian District, Shenzhen, China</p>
            <ul>
              <li><a href="mailto:info@cncpioneer.com">Email: info@cncpioneer.com</a></li>
              <li><a href="tel:+8613725562746">Phone: +8613725562746 </a></li>
              <li>Hours: Mon-Fri 9:00AM - 6:00PM</li>
            </ul>
          </section>
        </div>
      </div>
      <div class="copyright">
        <p>Copyright &copy; 2026 CNCPioneer All Rights Reserved.</p>
      </div>
    </footer>
    <script>
      const tocBoxes = document.querySelectorAll("[data-toc]");

      for (const toc of tocBoxes) {
        const toggle = toc.querySelector("[data-toc-toggle]");
        const body = toc.querySelector("[data-toc-body]");
        const links = Array.from(toc.querySelectorAll(".toc-list a"));
        const content = document.getElementById("main-article-content");
        const sourceHeadings = Array.from(content?.querySelectorAll("h2") || []);

        sourceHeadings.forEach((heading, index) => {
          const id = links[index]?.getAttribute("href")?.slice(1);
          if (id && !heading.id) heading.id = id;
        });

        const headings = links
          .map((link) => {
            const id = link.getAttribute("href")?.slice(1);
            return id ? document.getElementById(id) : null;
          })
          .filter(Boolean);
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const compactView = window.matchMedia("(max-width: 1024px)");
        let isExpanded = !compactView.matches;

        const setExpanded = (expanded) => {
          isExpanded = expanded;
          toc.classList.toggle("is-collapsed", !expanded);
          toggle?.setAttribute("aria-expanded", String(expanded));
          body?.setAttribute("aria-hidden", String(!expanded));
          for (const link of links) link.tabIndex = expanded ? 0 : -1;
        };

        setExpanded(isExpanded);

        compactView.addEventListener("change", (event) => {
          setExpanded(!event.matches);
        });

        toggle?.addEventListener("click", () => {
          setExpanded(!isExpanded);
        });

        for (const link of links) {
          link.addEventListener("click", (event) => {
            const id = link.getAttribute("href")?.slice(1);
            const target = id ? document.getElementById(id) : null;
            if (!target || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;

            event.preventDefault();
            // Finish collapsing the mobile TOC before calculating the destination.
            if (compactView.matches) {
              toc.classList.add("is-navigating");
              setExpanded(false);
            }
            target.scrollIntoView({ behavior: prefersReducedMotion ? "instant" : "smooth", block: "start" });
            history.pushState(null, "", `#${id}`);
            requestAnimationFrame(() => toc.classList.remove("is-navigating"));
          });
        }

        if ("IntersectionObserver" in window && headings.length > 0) {
          const byId = new Map(links.map((link) => [link.getAttribute("href")?.slice(1), link]));
          const observer = new IntersectionObserver(
            (entries) => {
              const visible = entries
                .filter((entry) => entry.isIntersecting)
                .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
              if (!visible?.target?.id) return;

              for (const link of links) link.removeAttribute("aria-current");
              byId.get(visible.target.id)?.setAttribute("aria-current", "true");
            },
            { rootMargin: "-20% 0px -70% 0px", threshold: 0 }
          );

          for (const heading of headings) observer.observe(heading);
        }
      }
    </script>
    <SiteSearch />
  </body>
</html>
