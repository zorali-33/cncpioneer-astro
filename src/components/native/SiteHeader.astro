---
import '../../styles/site-shell.css';
import IndustryNavigation from './IndustryNavigation.astro';
import NavigationMaterialGroup from './NavigationMaterialGroup.astro';
import {getSiteNavigation} from '../../data/siteNavigation.mjs';
import SiteSearch from "./SiteSearch.astro";
const nav = getSiteNavigation(Astro.url.pathname);
---
<header class="site-header" data-native-header>
  <div class="topbar">
    <div class="topbar__inner">
      <div class="topbar__contact" aria-label="Contact information">
        <a href="tel:+8613725562746" aria-label="Call CNCPioneer">
          <svg aria-hidden="true" viewBox="0 0 512 512"><path d="M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.7-98.9 140.5-177.2 177.2l-49.6-60.6c-6.8-8.3-18.2-11.1-28-6.9l-112 48C3.9 366.5-2 378.1.6 389.4l24 104C27.1 504.2 36.7 512 48 512c256.1 0 464-207.5 464-464 0-11.2-7.7-20.9-18.6-23.4z"></path></svg>
          <span>+8613725562746</span>
        </a>
        <a href="mailto:info@cncpioneer.com" aria-label="Email CNCPioneer">
          <svg aria-hidden="true" viewBox="0 0 512 512"><path d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z"></path></svg>
          <span>info@cncpioneer.com</span>
        </a>
      </div>
      <div class="topbar__tools" aria-label="Header tools">
        <a class="site-search-trigger" href="/search" aria-label="Search" data-site-search-open aria-haspopup="dialog" aria-controls="site-search-dialog" aria-expanded="false">
          <svg aria-hidden="true" viewBox="0 0 512 512"><path d="M505 442.7 405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128S137.3 80 208 80s128 57.2 128 128-57.3 128-128 128z"></path></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="CNCPioneer home">
      <img src="/wp-content/uploads/2025/11/cncpioneer_nav_logo.png" alt="CNC Pioneer" width="160" height="35" />
    </a>
    <a class="site-search-trigger site-search-trigger--mobile" href="/search" aria-label="Search" data-site-search-open aria-haspopup="dialog" aria-controls="site-search-dialog" aria-expanded="false">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" style="fill:none;stroke:currentColor;stroke-width:2"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
    </a>
    <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-nav">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
      {
        nav.map((item) => (
          <div class:list={["nav-item", item.children && "has-menu", item.active && "is-active"]}>
            {item.href ? <>
              <a href={item.href} aria-current={item.active ? (Astro.url.pathname === item.href ? "page" : "location") : undefined}>{item.label}</a>
              {item.children && <button class="submenu-toggle" type="button" aria-expanded="false" aria-controls={`${item.id || item.href.slice(1)}-submenu`} aria-label={`Open ${item.label} menu`}>▾</button>}
            </> : <button class="submenu-toggle nav-label-button" type="button" aria-expanded="false" aria-controls={`${item.id}-submenu`} aria-label={`Open ${item.label} menu`}>{item.label}<span aria-hidden="true">▾</span></button>}
            {item.children && (
              <div class="submenu" id={`${item.id || item.href.slice(1)}-submenu`}>
                {item.href === '/industries' ? <IndustryNavigation /> : item.children.map((child) => child.children ? <NavigationMaterialGroup group={child} /> : <a href={child.href}>{child.label}</a>)}
              </div>
            )}
          </div>
        ))
      }
    </nav>
  </div>
</header>
<SiteSearch />

<script>
  for (const header of document.querySelectorAll("[data-native-header]")) {
    const syncHeaderHeight = () => document.documentElement.style.setProperty("--site-header-height", `${header.offsetHeight}px`);
    syncHeaderHeight();
    new ResizeObserver(syncHeaderHeight).observe(header);
    const menuButton = header.querySelector(".menu-toggle");
    const nav = header.querySelector(".primary-nav");
    const closeSubmenus = () => {
      for (const item of header.querySelectorAll(".has-menu")) {
        item.classList.remove("is-open");
        item.setAttribute("data-menu-dismissed", "");
        item.querySelector(".submenu-toggle")?.setAttribute("aria-expanded", "false");
      }
    };
    const closeMenu = () => {
      closeSubmenus();
      menuButton?.setAttribute("aria-expanded", "false");
      menuButton?.setAttribute("aria-label", "Open navigation menu");
      nav?.classList.remove("is-open");
    };
    menuButton?.addEventListener("click", () => {
      const open = menuButton.getAttribute("aria-expanded") !== "true";
      menuButton.setAttribute("aria-expanded", String(open));
      menuButton.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
      nav?.classList.toggle("is-open", open);
      if (!open) closeSubmenus();
    });

    for (const toggle of header.querySelectorAll(".submenu-toggle")) {
      toggle.addEventListener("click", () => {
        const item = toggle.closest(".nav-item");
        const open = toggle.getAttribute("aria-expanded") !== "true";
        closeSubmenus();
        toggle.setAttribute("aria-expanded", String(open));
        item?.classList.toggle("is-open", open);
        if (open) item?.removeAttribute("data-menu-dismissed");
      });
      toggle.closest(".nav-item")?.addEventListener("mouseenter", () => toggle.closest(".nav-item")?.removeAttribute("data-menu-dismissed"));
      toggle.closest(".nav-item")?.addEventListener("focusout", (event) => {
        const item = toggle.closest(".nav-item");
        if (item && !item.contains(event.relatedTarget)) {
          toggle.setAttribute("aria-expanded", "false");
          item.classList.remove("is-open");
          item.removeAttribute("data-menu-dismissed");
        }
      });
    }
    header.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const item = event.target instanceof Element ? event.target.closest(".has-menu") : null;
      if (item && item.querySelector(".submenu-toggle")?.getAttribute("aria-expanded") === "true") {
        closeSubmenus();
        item.querySelector(".submenu-toggle")?.focus();
      } else if (menuButton?.getAttribute("aria-expanded") === "true") {
        closeMenu();
        menuButton.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) closeMenu();
    });
    window.matchMedia("(max-width: 1024px)").addEventListener("change", closeMenu);
  }
</script>
