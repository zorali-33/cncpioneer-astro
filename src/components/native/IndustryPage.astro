            {section.items?.length > 0 && (
              <ul class="check-list">{section.items.map((item) => <li>{item}</li>)}</ul>
            )}
          </div>
          {index % 2 === 0 && section.image && <img src={section.image} alt={section.heading} loading="lazy" />}
        </section>
      ))}

      {gallery.length > 0 && (
        <section class="section">
          <h2>{page.galleryHeading}</h2>
          <div class="media-grid product-media-grid">
            {gallery.map((item) => (
              <figure class="media-card product-media-card">
                <img src={item.image} alt={item.alt || item.name} loading="lazy" />
                <figcaption>{item.name}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </>
  )}

  {consolidation && (
    <section class="section industry-consolidation" aria-labelledby="industry-applications-title">
      <h2 id="industry-applications-title">Component Applications & Manufacturing Requirements</h2>
      <div class="industry-application-grid">
        {consolidation.applications.map(([title, text, link]) => (
          <article><h3>{title}</h3><p>{text}</p>{link && <a class="industry-application-link" href={link.href}>{link.label}<span aria-hidden="true"> →</span></a>}</article>
        ))}
      </div>
      {consolidation.production && (
        <section aria-labelledby="robotics-production-title">
          <h2 id="robotics-production-title">{consolidation.production.title}</h2>
          <p>{consolidation.production.description}</p>
          <div class="industry-application-grid">
            {consolidation.production.items.map(([title, text]) => (
              <article><h3>{title}</h3><p>{text}</p></article>
            ))}
          </div>
        </section>
      )}
      <h2 id="industry-faq-title">Frequently Asked Questions</h2>
      <div class="industry-faq" aria-labelledby="industry-faq-title">
        {consolidation.faqs.map(([question, answer]) => (
          <details><summary>{question}</summary><p>{answer}</p></details>
        ))}
      </div>
    </section>
  )}

  {specialization?.faqs?.length > 0 && <IndustryFaq items={specialization.faqs} title={specialization.faqTitle} id="satellite-machining-faq" />}

  <QuoteCta id={`industry-${sourcePage.slug}-quote`} idPrefix={`industry-${sourcePage.slug}-quote-form`} formName={`${page.title} Industry Enquiry`} kicker="INDUSTRY COMPONENTS" title={`Discuss ${page.title} machining requirements`} description="Share the part drawing, material, quantity and application requirements for a project-specific review." />
  <script>
    const setupPartsShowcases = () => {
      document.querySelectorAll("[data-parts-showcase]").forEach((showcase) => {
        const track = showcase.querySelector("[data-parts-track]");
        const prev = showcase.querySelector("[data-parts-prev]");
        const next = showcase.querySelector("[data-parts-next]");
        const dots = [...showcase.querySelectorAll("[data-parts-dot]")];

        if (!(track instanceof HTMLElement) || dots.length === 0) return;

        const cards = [...track.querySelectorAll(".part-card")];
        const getStep = () => {
          const firstCard = cards[0];
          if (!(firstCard instanceof HTMLElement)) return track.clientWidth;
          const styles = window.getComputedStyle(track);
          const gap = Number.parseFloat(styles.columnGap || styles.gap || "0") || 0;
          return firstCard.getBoundingClientRect().width + gap;
        };

        const getActiveIndex = () => {
          const step = getStep();
          if (!step) return 0;
          return Math.max(0, Math.min(dots.length - 1, Math.round(track.scrollLeft / step)));
        };

        const update = () => {
          const activeIndex = getActiveIndex();
          const maxScrollLeft = Math.max(0, track.scrollWidth - track.clientWidth - 2);
          dots.forEach((dot, index) => {
            const isActive = index === activeIndex;
            dot.classList.toggle("is-active", isActive);
            dot.setAttribute("aria-current", isActive ? "true" : "false");
          });
          if (prev instanceof HTMLButtonElement) prev.disabled = track.scrollLeft <= 2;
          if (next instanceof HTMLButtonElement) next.disabled = track.scrollLeft >= maxScrollLeft;
        };

        const scrollToIndex = (index) => {
          track.scrollTo({ left: getStep() * index, behavior: "smooth" });
        };

        prev?.addEventListener("click", () => scrollToIndex(getActiveIndex() - 1));
        next?.addEventListener("click", () => scrollToIndex(getActiveIndex() + 1));
        dots.forEach((dot) => {
          dot.addEventListener("click", () => {
            const index = Number(dot.getAttribute("data-parts-dot") || "0");
            scrollToIndex(index);
          });
        });
        track.addEventListener("scroll", () => window.requestAnimationFrame(update), { passive: true });
        window.addEventListener("resize", update);
        update();
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupPartsShowcases, { once: true });
    } else {
      setupPartsShowcases();
    }
  </script>
</BaseLayout>
