import "../../styles/industry-detail.css";

const sourcePage = Astro.props.page;
const consolidation = industryConsolidation[sourcePage.slug];
const specialization = industrySpecializations[sourcePage.slug];
const page = specialization ? {
  ...sourcePage,
  hero: { ...sourcePage.hero, ...specialization.hero },
  seo: { ...sourcePage.seo, ...specialization.seo }
} : { ...sourcePage };
if (consolidation) {
  page.hero = { ...page.hero, title: consolidation.title, description: consolidation.description };
  page.seo = { ...page.seo, title: consolidation.seoTitle ?? `${consolidation.title} | CNCPioneer`, description: consolidation.description };
}
const sections = page.sections.filter((section) => section.heading && section.heading !== "Questions?");
const gallery = page.gallery.slice(0, 12);

