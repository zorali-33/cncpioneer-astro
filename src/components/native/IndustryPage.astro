const createIndustryDetail = (config, industryName) => ({
  usage: {
    title: "How Do You Use Our Machining Services",
    cards: config.usage.map(([icon, title, text]) => ({ icon, title, text }))
  },
  quality: commonQualityCards(industryName),
  materials: materialProfiles[config.materials],
  parts: {
    title: config.partsTitle,
    subtitle: config.partsSubtitle,
    items: config.parts.map(([title, image, href]) => ({ title, image, href }))
  },
  resources: config.resources.map(([title, href, image, excerpt]) => ({ title, href, image, excerpt }))
});

const industryDetail = withIndustryProductLinks(page.slug, specialization?.detail || (page.slug === "semiconductor"
  ? semiconductorDetail
  : mainIndustryConfigs[page.slug]
    ? createIndustryDetail(mainIndustryConfigs[page.slug], page.hero.title)
    : null));
const materialVisuals = industryDetail?.materials.items.map(getIndustryMaterialVisual) || [];
const materialLinkProcess = page.slug.endsWith("-swiss-machining") ? "swiss" : "cnc";
const materialLinks = industryDetail?.materials.items.map((material) =>
  getIndustryMaterialLinks(material, { process: materialLinkProcess })
) || [];
