  "Anodizing",
  "Electropolishing",
  "PVD Coating",
  "Polishing",
  "Brushing",
  "Nickel Plating",
  "Clean Packaging"
];

const buildMaterials = (subtitle, rows, finishes = standardFinishes) => ({
  title: "Recommended Materials & Surface Finishes",
  subtitle,
  items: rows.map(([tab, badge, icon, name, spec, summary, leadTime, finishing, bestFitParts]) => ({
    tab,
    badge,
    icon,
    name,
    spec,
    summary,
    facts: [
      ["Lead Time", leadTime],
      ["Finishing Options", finishing],
      ["Best-Fit Parts", bestFitParts]
    ]
  })),
  finishes: finishes.map((label, index) => ({ label, highlight: index === 0 || index === 3 }))
});

